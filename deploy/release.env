# Release metadata for byro deployments, read by byroctl before an update.
# This file is versioned immutably with every release tag.
#
# Both flags default to 0 on main. A flag is set to 1 only in the release PR
# that needs it and reset to 0 right after the release; CI fails if a flag is
# still 1 after a release has been published.
#
# BYRO_RELEASE_BREAKING=1: administrators must read the release notes and
# explicitly confirm the update (operational or configuration changes that
# need attention before updating). Details always live in the release notes.
BYRO_RELEASE_BREAKING=0
# BYRO_RELEASE_DATA_MIGRATION=1: this release changes persistent files outside
# the database (documents, uploads, GnuPG home). The regular pre-update
# safeguard is not sufficient; a full backup of data/ is required first.
BYRO_RELEASE_DATA_MIGRATION=0
