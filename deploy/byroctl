#!/usr/bin/env bash
# byroctl - install and manage a byro Docker Compose deployment.
#
# byroctl lives in the installation directory (BYRO_ROOT, default /opt/byro)
# next to byro.conf and the Compose files it installed. Docker Compose remains
# the source of truth at runtime: everything byroctl starts can be inspected and
# operated with plain "docker compose" in that directory.
#
# Commands
#   install      create byro.conf, fetch the Compose files, pull, migrate, start
#   config       get | set | edit | check the configuration in byro.conf
#   start | stop | restart | logs
#   manage       run a byro/Django management command in a one-off container
#   plugin       list | add | remove | update | rebuild plugins (derived image)
#   update       update to the current stable release
#   version      show the pinned byro version and the running one
#   help
#
# Conventions inside this script
#   * set -euo pipefail is enabled in main(), not at top level, so that the test
#     suite can source the file and exercise single functions.
#   * grep without a match returns 1; never use it unguarded in an assignment
#     (append "|| true" or use "if grep -q").
#   * Remote artefacts are downloaded only over https from BYROCTL_RAW_BASE.
#     BYROCTL_SOURCE_DIR (a local deploy/ checkout) is the development and test
#     path and is reported as an unverified source.
#   * Secrets never travel on the command line; see ask_secret().

if (( BASH_VERSINFO[0] < 4 )); then
    printf 'byroctl: ERROR: bash >= 4 is required (found %s)\n' "$BASH_VERSION" >&2
    exit 1
fi

BYROCTL_MIN_DOCKER="24.0.0"
BYROCTL_MIN_COMPOSE="2.20.0"
BYROCTL_DEFAULT_REPO="ghcr.io/byro/byro"
: "${BYROCTL_RAW_BASE:=https://raw.githubusercontent.com/byro/byro}"
: "${BYROCTL_SOURCE_DIR:=}"
BYROCTL_ARTIFACTS=(docker-compose.yml compose/postgres.yml compose/caddy.yml compose/plugins.yml Caddyfile byro.conf.example release.env plugin-catalog.conf plugins/Dockerfile)
BYROCTL_WEB_HEALTH_TIMEOUT="${BYROCTL_WEB_HEALTH_TIMEOUT:-180}"
BYROCTL_DB_HEALTH_TIMEOUT="${BYROCTL_DB_HEALTH_TIMEOUT:-120}"

# State shared between functions (set in main / cmd_*).
BYRO_ROOT=""
CONF_FILE=""
LOCK_DIR=""
NONINTERACTIVE=0
declare -A PRESET=()
MISSING=()
PLUGINS_FILE=""                       # $BYRO_ROOT/plugins/plugins.txt (set in main)
PLUGINS_COMPOSE="compose/plugins.yml" # the add-on that switches to the derived image
INSTALL_PLUGINS=()                    # --plugin arguments of byroctl install
PLUGINS_SAFEGUARD=""                  # the pre-plugin safeguard of the running command

# --- output -------------------------------------------------------------------

log()  { printf 'byroctl: %s\n' "$*" >&2; }
warn() { printf 'byroctl: WARNING: %s\n' "$*" >&2; }
# die MESSAGE [EXIT_CODE]
die()  { printf 'byroctl: ERROR: %s\n' "$1" >&2; exit "${2:-1}"; }

# --- validation ---------------------------------------------------------------

valid_url()      { [[ "$1" =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?$ ]]; }
valid_email()    { [[ "$1" =~ ^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$ ]]; }
valid_username() { [[ "$1" =~ ^[A-Za-z0-9@._+-]+$ ]]; }
valid_version()  { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; }
valid_digest()   { [[ "$1" =~ ^sha256:[0-9a-f]{64}$ ]]; }
valid_conf_key() { [[ "$1" =~ ^[A-Z][A-Z0-9_]*$ ]]; }
is_secret_key()  { [[ "$1" == *PASS* || "$1" == *SECRET* ]]; }

# valid_plugin_spec SPEC: a loose sanity check for one pip requirement line;
# pip stays the authority. Rejected: pip options (a leading "-" or whitespace
# followed by "-"), "#" (a comment marker for pip, and byroctl appends its own),
# "$" (pip expands variables in requirement files), ";" and "\" (markers and
# line continuations) and control characters.
valid_plugin_spec() {
    [[ -n "$1" && "$1" != -* && ! "$1" =~ [[:space:]]- && "$1" != *'#'* && "$1" != *'$'* \
        && "$1" != *';'* && "$1" != *\\* && ! "$1" =~ [[:cntrl:]] ]]
}
# plugin_spec_pinned SPEC: an exact version, a VCS ref or a local path
plugin_spec_pinned() { [[ "$1" == *==* || "$1" =~ @[^@/[:space:]]+$ || "$1" == ./* || "$1" == /* ]]; }
valid_plugin_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }
valid_commit_sha()  { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }

# version_ge A B: true if A >= B (dotted numbers)
version_ge() { [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n1)" == "$2" ]]; }

# --- configuration file (KEY=VALUE, '#' comments) ------------------------------
#
# Quoting follows what Docker Compose does with .env and env_file values, which
# was verified experimentally:
#   * unquoted and double-quoted values are interpolated ($VAR, ${VAR}), and an
#     unquoted " #" starts a comment;
#   * single-quoted values are taken literally, the only escape is \' for an
#     apostrophe; backslashes stay as they are.
# byroctl therefore single-quotes every value that contains anything outside a
# small safe character set. A value ending in a backslash would turn the closing
# quote into \' and is rejected, as are newlines.

conf_encode() {
    local value="$1"
    if [[ "$value" == *$'\n'* ]]; then
        printf 'value must not contain newlines\n' >&2
        return 1
    fi
    if [[ "$value" == *\\ ]]; then
        printf 'value must not end with a backslash (ambiguous in .env quoting)\n' >&2
        return 1
    fi
    if [[ -z "$value" || "$value" =~ ^[A-Za-z0-9_@%+=:,./-]+$ ]]; then
        printf '%s' "$value"
        return 0
    fi
    local bs="\\" q="'"
    value="${value//"$q"/"$bs$q"}"
    printf "'%s'" "$value"
}

conf_decode() {
    local raw="$1" bs="\\" q="'"
    if [[ ${#raw} -ge 2 && "$raw" == "'"*"'" ]]; then
        raw="${raw:1:${#raw}-2}"
        raw="${raw//"$bs$q"/"$q"}"
    elif [[ ${#raw} -ge 2 && "$raw" == '"'*'"' ]]; then
        raw="${raw:1:${#raw}-2}"
    else
        # unquoted: an inline comment starts at whitespace followed by '#'
        if [[ "$raw" =~ ^(.*[^[:space:]])?[[:space:]]+#.*$ ]]; then
            raw="${BASH_REMATCH[1]}"
        fi
        raw="${raw%"${raw##*[![:space:]]}"}"
    fi
    printf '%s' "$raw"
}

# conf_get KEY [FILE]: prints the decoded value of the last active definition;
# returns 1 if the key is not set.
conf_get() {
    local key="$1" file="${2:-$CONF_FILE}" line value="" found=1
    [[ -f "$file" ]] || return 1
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" == "$key="* ]] || continue
        value="${line#"$key="}"
        found=0
    done <"$file"
    (( found == 0 )) || return 1
    conf_decode "$value"
}

# conf_has KEY [FILE]: true if the key has a non-empty value.
conf_has() {
    local value
    value="$(conf_get "$1" "${2:-$CONF_FILE}" 2>/dev/null)" || return 1
    [[ -n "$value" ]]
}

# conf_set KEY VALUE [FILE]: replaces the active or commented-out definition in
# place (keeping comments and order), appends if missing. Atomic via temp file,
# mode 0600.
conf_set() {
    local key="$1" value="$2" file="${3:-$CONF_FILE}" encoded tmp line replaced=0
    valid_conf_key "$key" || die "invalid configuration key: $key"
    encoded="$(conf_encode "$value")" || die "cannot store $key: $(conf_encode "$value" 2>&1 >/dev/null)"
    tmp="$(mktemp "$file.XXXXXX")"
    if [[ -f "$file" ]]; then
        while IFS= read -r line || [[ -n "$line" ]]; do
            if [[ "$line" == "$key="* || "$line" == "#$key="* ]]; then
                if (( replaced == 0 )); then
                    printf '%s=%s\n' "$key" "$encoded" >>"$tmp"
                    replaced=1
                elif [[ "$line" == "#$key="* ]]; then
                    printf '%s\n' "$line" >>"$tmp"
                fi
                # further active duplicates are dropped
            else
                printf '%s\n' "$line" >>"$tmp"
            fi
        done <"$file"
    fi
    if (( replaced == 0 )); then
        printf '%s=%s\n' "$key" "$encoded" >>"$tmp"
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$file"
}

# conf_mask KEY VALUE: hides secrets for display.
conf_mask() {
    if is_secret_key "$1" && [[ -n "$2" ]]; then
        printf '********'
    else
        printf '%s' "$2"
    fi
}

# compose_files [FILE]: the COMPOSE_FILE list as separate lines.
compose_files() {
    local value
    value="$(conf_get COMPOSE_FILE "${1:-$CONF_FILE}" 2>/dev/null || true)"
    [[ -n "$value" ]] || value="docker-compose.yml"
    tr ':' '\n' <<<"$value"
}

compose_file_active() { compose_files "${2:-$CONF_FILE}" | grep -qx -- "$1"; }

# compose_file_add PATH / compose_file_remove PATH: toggle an add-on fragment in
# COMPOSE_FILE; the order of the other entries is kept.
compose_file_add() {
    compose_file_active "$1" && return 0
    conf_set COMPOSE_FILE "$(compose_files | tr '\n' ':')$1"
}
compose_file_remove() {
    local value
    compose_file_active "$1" || return 0
    value="$(compose_files | grep -vx -- "$1" | tr '\n' ':' || true)"
    conf_set COMPOSE_FILE "${value%:}"
}

# --- secrets and prompts --------------------------------------------------------

# gen_password: 32 alphanumeric characters from /dev/urandom. head reads first,
# so no SIGPIPE is raised under pipefail.
gen_password() {
    local pw=""
    while (( ${#pw} < 32 )); do
        pw+="$(head -c 48 /dev/urandom | base64 | tr -dc 'A-Za-z0-9')"
    done
    printf '%s' "${pw:0:32}"
}

# ask VAR PROMPT [DEFAULT] [VALIDATOR]
# Order: --set preset, then interactive prompt. In --non-interactive mode a
# missing value is recorded in MISSING instead of prompting.
ask() {
    local var="$1" prompt="$2" default="${3:-}" validator="${4:-}" value
    if [[ -n "${PRESET[$var]+x}" ]]; then
        value="${PRESET[$var]}"
        if [[ -n "$validator" ]] && ! "$validator" "$value"; then
            die "invalid value for $var: $value"
        fi
        printf -v "$var" '%s' "$value"
        return 0
    fi
    if (( NONINTERACTIVE )); then
        if [[ -n "$default" ]]; then
            printf -v "$var" '%s' "$default"
        else
            MISSING+=("$var")
        fi
        return 0
    fi
    [[ -t 0 ]] || die "no terminal for interactive questions. Use --non-interactive with --set KEY=VALUE (secrets via BYROCTL_* environment variables)."
    while true; do
        if [[ -n "$default" ]]; then
            read -r -p "$prompt [$default]: " value
            [[ -n "$value" ]] || value="$default"
        else
            read -r -p "$prompt: " value
        fi
        if [[ -n "$validator" ]] && ! "$validator" "$value"; then
            printf 'byroctl: invalid value, please try again.\n' >&2
            continue
        fi
        break
    done
    printf -v "$var" '%s' "$value"
}

# ask_secret VAR ENVNAME PROMPT [CONFIRM]
# Secrets come from the named environment variable or from a hidden prompt,
# never from --set (command lines end up in ps and shell history).
ask_secret() {
    local var="$1" envname="$2" prompt="$3" confirm="${4:-}" value again
    if [[ -n "${!envname:-}" ]]; then
        printf -v "$var" '%s' "${!envname}"
        return 0
    fi
    if (( NONINTERACTIVE )); then
        MISSING+=("$envname (environment variable)")
        return 0
    fi
    [[ -t 0 ]] || die "no terminal to ask for $prompt; set $envname in the environment."
    while true; do
        read -r -s -p "$prompt: " value; printf '\n' >&2
        [[ -n "$value" ]] || { printf 'byroctl: a value is required.\n' >&2; continue; }
        if [[ -n "$confirm" ]]; then
            read -r -s -p "$prompt (again): " again; printf '\n' >&2
            [[ "$value" == "$again" ]] || { printf 'byroctl: values do not match, please try again.\n' >&2; continue; }
        fi
        break
    done
    printf -v "$var" '%s' "$value"
}

confirm() { # confirm PROMPT [default y|n]
    local prompt="$1" default="${2:-n}" answer
    (( NONINTERACTIVE )) && [[ "$default" == y ]] && return 0
    (( NONINTERACTIVE )) && return 1
    [[ -t 0 ]] || return 1
    read -r -p "$prompt [$([[ "$default" == y ]] && printf 'Y/n' || printf 'y/N')]: " answer
    [[ -z "$answer" ]] && answer="$default"
    [[ "$answer" =~ ^[YyJj] ]]
}

# --- lock ----------------------------------------------------------------------

acquire_lock() {
    local dir="$BYRO_ROOT/.byroctl/lock" pid
    mkdir -p "$BYRO_ROOT/.byroctl"
    if ! mkdir "$dir" 2>/dev/null; then
        pid="$(cat "$dir/pid" 2>/dev/null || true)"
        if [[ "$pid" == "$$" ]]; then
            # same process after the stage-2 exec: keep the lock
            LOCK_DIR="$dir"
            trap release_lock EXIT
            return 0
        fi
        if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
            die "another byroctl process (pid $pid) is running in $BYRO_ROOT"
        fi
        warn "removing stale lock left by pid ${pid:-unknown}"
        rm -rf "$dir"
        mkdir "$dir" || die "cannot create lock $dir"
    fi
    printf '%s\n' "$$" >"$dir/pid"
    LOCK_DIR="$dir"
    trap release_lock EXIT
}

release_lock() {
    if [[ -n "$LOCK_DIR" && -d "$LOCK_DIR" ]]; then
        rm -rf "$LOCK_DIR"
    fi
    LOCK_DIR=""
    # a plugin snapshot that was not consumed (the command died before phase 2)
    if [[ -n "${PLUGIN_SNAPSHOT:-}" && -d "$PLUGIN_SNAPSHOT" ]]; then
        rm -rf "$PLUGIN_SNAPSHOT"
    fi
    PLUGIN_SNAPSHOT=""
}

# --- docker -----------------------------------------------------------------------

need_docker() {
    local dv cv
    command -v docker >/dev/null 2>&1 || die "docker not found. Install Docker Engine >= $BYROCTL_MIN_DOCKER with the compose plugin."
    if ! dv="$(docker version --format '{{.Server.Version}}' 2>/dev/null)"; then
        die "cannot talk to the Docker daemon. Is Docker running and is your user in the docker group?"
    fi
    version_ge "${dv%%[-+]*}" "$BYROCTL_MIN_DOCKER" || die "Docker $dv is too old, byro needs >= $BYROCTL_MIN_DOCKER"
    if ! cv="$(docker compose version --short 2>/dev/null)"; then
        die "the docker compose plugin is missing (need >= $BYROCTL_MIN_COMPOSE)"
    fi
    version_ge "${cv#v}" "$BYROCTL_MIN_COMPOSE" || die "docker compose $cv is too old, byro needs >= $BYROCTL_MIN_COMPOSE"
}

# All compose calls run in BYRO_ROOT (main() changes into it), so COMPOSE_FILE
# from .env resolves relative to the installation.
compose() { docker compose "$@"; }

image_exists() { docker manifest inspect "$1" >/dev/null 2>&1; }
image_local()  { docker image inspect "$1" >/dev/null 2>&1; }

# image_digest REPO REF: the index digest recorded for REPO when REF was pulled,
# empty if none (locally built images have no RepoDigests).
image_digest() {
    local repo="$1" ref="$2" line
    line="$(docker image inspect "$ref" --format '{{range .RepoDigests}}{{println .}}{{end}}' 2>/dev/null \
        | grep -F -- "$repo@sha256:" | head -n1 || true)"
    printf '%s' "${line#"$repo@"}"
}

# pull_images REF: pull the byro base image by tag (image_digest needs the tag
# pull) and everything else the stack uses. With the plugin add-on no service
# references the base image and web/periodic/manage are built locally, so the
# buildable image is skipped.
pull_images() {
    if compose_file_active "$PLUGINS_COMPOSE"; then
        docker pull "$1"
        compose pull --ignore-buildable
    else
        compose pull
    fi
}

need_buildx() {
    docker buildx version >/dev/null 2>&1 \
        || die "the docker buildx plugin is missing; byro builds the plugin image with it (Debian/Ubuntu: apt install docker-buildx-plugin)"
}

container_id() { compose ps -q "$1" 2>/dev/null | head -n1 || true; }

# wait_healthy SERVICE [TIMEOUT_SECONDS]
wait_healthy() {
    local service="$1" timeout="${2:-120}" waited=0 cid status
    while true; do
        cid="$(container_id "$service")"
        if [[ -n "$cid" ]]; then
            status="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$cid" 2>/dev/null || true)"
            case "$status" in
                healthy) return 0 ;;
                running) return 0 ;;   # no health check defined
                exited|dead) break ;;
            esac
        fi
        if (( waited >= timeout )); then
            break
        fi
        sleep 2; waited=$((waited + 2))
    done
    warn "service $service did not become healthy within ${timeout}s (status: ${status:-no container}); last log lines:"
    compose logs --no-log-prefix --tail=40 "$service" >&2 2>/dev/null || true
    return 1
}

# active_services: services of the active compose files without profile-only ones.
active_services() { compose config --services 2>/dev/null || true; }

# port_in_use PORT [HOST]: true if something accepts connections.
port_in_use() {
    local port="$1" host="${2:-127.0.0.1}"
    (exec 3<>"/dev/tcp/$host/$port") 2>/dev/null
}

# --- artefacts --------------------------------------------------------------------

require_https() { [[ "$1" == https://* ]] || die "$2 must use https:// (got: $1)"; }

sha256_of() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    else
        shasum -a 256 "$1" | awk '{print $1}'
    fi
}

# fetch_artifact TAG RELPATH DEST: copy from BYROCTL_SOURCE_DIR or download from
# the release tag over https only.
fetch_artifact() {
    local tag="$1" relpath="$2" dest="$3"
    if [[ -n "$BYROCTL_SOURCE_DIR" ]]; then
        [[ -f "$BYROCTL_SOURCE_DIR/$relpath" ]] || die "missing $relpath in BYROCTL_SOURCE_DIR=$BYROCTL_SOURCE_DIR"
        cp "$BYROCTL_SOURCE_DIR/$relpath" "$dest"
    else
        require_https "$BYROCTL_RAW_BASE" "BYROCTL_RAW_BASE"
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
            -o "$dest" "$BYROCTL_RAW_BASE/$tag/deploy/$relpath" \
            || die "download failed: $BYROCTL_RAW_BASE/$tag/deploy/$relpath"
    fi
}

# verify_checksum SUMSFILE RELPATH FILE
verify_checksum() {
    local sums="$1" relpath="$2" file="$3" expected actual
    expected="$(awk -v f="$relpath" '$2 == f {print $1}' "$sums" | head -n1)"
    [[ -n "$expected" ]] || die "no checksum for $relpath in SHA256SUMS"
    actual="$(sha256_of "$file")"
    [[ "$actual" == "$expected" ]] || die "checksum mismatch for $relpath (expected $expected, got $actual)"
}

# install_artifacts TAG: fetch every deploy artefact of TAG into BYRO_ROOT,
# verified against the SHA256SUMS of the same tag, byte-identical copies.
install_artifacts() {
    local tag="$1" relpath tmp sums=""
    if [[ -n "$BYROCTL_SOURCE_DIR" ]]; then
        log "copying deployment files from local source $BYROCTL_SOURCE_DIR (unverified development source)"
    else
        sums="$(mktemp "$BYRO_ROOT/.SHA256SUMS.XXXXXX")"
        fetch_artifact "$tag" SHA256SUMS "$sums"
    fi
    for relpath in "${BYROCTL_ARTIFACTS[@]}"; do
        mkdir -p "$BYRO_ROOT/$(dirname "$relpath")"
        tmp="$(mktemp "$BYRO_ROOT/$relpath.XXXXXX")"
        fetch_artifact "$tag" "$relpath" "$tmp"
        if [[ -n "$sums" ]]; then
            verify_checksum "$sums" "$relpath" "$tmp"
        fi
        chmod 644 "$tmp"
        mv "$tmp" "$BYRO_ROOT/$relpath"
    done
    [[ -z "$sums" ]] || rm -f "$sums"
}

# --- root resolution ------------------------------------------------------------------

script_dir() {
    local src="${BASH_SOURCE[0]}" dir
    while [[ -L "$src" ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" == /* ]] || src="$dir/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

# --- install ------------------------------------------------------------------------------

valid_proxy_mode() { [[ "$1" =~ ^(caddy|own|none)$ ]]; }
valid_db_mode()    { [[ "$1" =~ ^(internal|external)$ ]]; }
valid_mail_mode()  { [[ "$1" =~ ^(host|smtp|skip)$ ]]; }
valid_lang()       { [[ "$1" =~ ^(de|en)$ ]]; }
valid_port()       { [[ "$1" =~ ^[0-9]{1,5}$ ]] && (( $1 >= 1 && $1 <= 65535 )); }
valid_bool()       { [[ "$1" =~ ^(true|false)$ ]]; }
valid_tz()         { [[ "$1" =~ ^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$ ]]; }
valid_hostname()   { [[ "$1" =~ ^[A-Za-z0-9.-]+$ ]]; }
valid_tag()        { [[ "$1" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; }
valid_project()    { [[ "$1" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; }

# add_preset KEY=VALUE (from --set). Secrets are refused on the command line.
add_preset() {
    local kv="$1" key value
    [[ "$kv" == *=* ]] || die "--set expects KEY=VALUE (got: $kv)" 64
    key="${kv%%=*}"; value="${kv#*=}"
    valid_conf_key "$key" || die "--set: invalid key $key" 64
    if is_secret_key "$key"; then
        die "--set: $key is a secret and must not be passed on the command line. Use the environment variables BYROCTL_DB_PASSWORD, BYROCTL_MAIL_PASSWORD, BYROCTL_OIDC_CLIENT_SECRET or BYROCTL_ADMIN_PASSWORD." 64
    fi
    PRESET["$key"]="$value"
}

detect_timezone() {
    local tz=""
    if [[ -r /etc/timezone ]]; then
        tz="$(head -n1 /etc/timezone 2>/dev/null || true)"
    fi
    if [[ -z "$tz" ]] && command -v timedatectl >/dev/null 2>&1; then
        tz="$(timedatectl show -p Timezone --value 2>/dev/null || true)"
    fi
    if [[ -z "$tz" && -L /etc/localtime ]]; then
        tz="$(readlink /etc/localtime | sed 's#.*/zoneinfo/##')"
    fi
    valid_tz "$tz" || tz="UTC"
    printf '%s' "$tz"
}

ensure_root_dir() {
    if [[ ! -d "$BYRO_ROOT" ]] && ! mkdir -p "$BYRO_ROOT" 2>/dev/null; then
        log "cannot create the installation directory $BYRO_ROOT."
        log "Create it once with administrator rights and hand it to your user:"
        log "    sudo mkdir -p '$BYRO_ROOT' && sudo chown '$(id -u):$(id -g)' '$BYRO_ROOT'"
        log "then run the installation again, or choose a directory you own with --root (e.g. --root ~/byro)."
        exit 1
    fi
    [[ -w "$BYRO_ROOT" ]] || die "installation directory $BYRO_ROOT is not writable by $(id -un)"
}

preflight_install() {
    local arch free_kb
    need_docker
    arch="$(uname -m)"
    case "$arch" in
        x86_64|aarch64|arm64) ;;
        *) die "unsupported architecture $arch (byro images exist for amd64 and arm64)" ;;
    esac
    free_kb="$(df -Pk "$BYRO_ROOT" 2>/dev/null | awk 'NR == 2 {print $4}')"
    if [[ -n "$free_kb" ]] && (( free_kb < 2 * 1024 * 1024 )); then
        die "less than 2 GB free in $BYRO_ROOT ($((free_kb / 1024)) MB); byro needs room for images and data"
    fi
    if [[ -z "$BYROCTL_SOURCE_DIR" ]]; then
        require_https "$BYROCTL_RAW_BASE" "BYROCTL_RAW_BASE"
    fi
}

# check_ports_free PORT...: every port must be free on 127.0.0.1.
check_ports_free() {
    local port busy=()
    for port in "$@"; do
        if port_in_use "$port"; then busy+=("$port"); fi
    done
    (( ${#busy[@]} == 0 )) && return 0
    log "the following ports are already in use on this host: ${busy[*]}"
    if [[ " ${busy[*]} " == *" 80 "* || " ${busy[*]} " == *" 443 "* ]]; then
        log "another web server or reverse proxy seems to be running. Choose the reverse proxy mode 'own'"
        log "(--set BYROCTL_PROXY=own) and forward it to byro, or stop the other service first."
    else
        log "choose another port with --set BYRO_DEPLOY_PORT=<port> or stop the service using it."
    fi
    exit 1
}

# write_state KEY VALUE: KEY=VALUE store for derived state (never configuration).
write_state() {
    local file="$BYRO_ROOT/.byroctl/state"
    mkdir -p "$BYRO_ROOT/.byroctl"
    touch "$file"
    conf_set "$1" "$2" "$file"
}

# collect_config VERSION: ask the installation questions and write byro.conf.
collect_config() {
    local version="$1"
    local BYRO_SITE_URL BYRO_LANGUAGE_CODE BYRO_TIME_ZONE BYROCTL_PROXY BYROCTL_DB BYROCTL_MAIL
    local BYRO_DB_HOST BYRO_DB_PORT BYRO_DB_NAME BYRO_DB_USER BYRO_DB_PASS
    local BYRO_MAIL_HOST BYRO_MAIL_PORT BYRO_MAIL_USER BYRO_MAIL_FROM BYRO_MAIL_TLS BYRO_MAIL_SSL BYRO_MAIL_PASSWORD
    local BYRO_DEPLOY_PORT BYRO_DEPLOY_BIND COMPOSE_PROJECT_NAME
    local https compose_file trust_proxy=false default_proxy tz key BYROCTL_PLUGINS

    log "No byro.conf yet - collecting the configuration for a new installation."
    # The deployment files first: the plugin question below validates against the
    # catalog of this release. A resumed installation picks up whatever is missing.
    install_artifacts "$version"
    ask BYRO_SITE_URL "Public URL of your byro (e.g. https://byro.example.org, no path)" "" valid_url
    if [[ "${BYRO_SITE_URL:-}" == https://* ]]; then https=true; default_proxy=caddy; else https=false; default_proxy=none; fi
    ask BYROCTL_PROXY "Reverse proxy: caddy (byro obtains TLS certificates itself, ports 80/443 must be free), own (you run a reverse proxy), none (direct access, tests only)" "$default_proxy" valid_proxy_mode
    ask BYRO_LANGUAGE_CODE "Language (de/en)" "de" valid_lang
    tz="$(detect_timezone)"
    ask BYRO_TIME_ZONE "Time zone" "$tz" valid_tz
    ask BYROCTL_DB "Database: internal (PostgreSQL managed by byro) or external" "internal" valid_db_mode
    if [[ "${BYROCTL_DB:-}" == external ]]; then
        ask BYRO_DB_HOST "Database host" "" valid_hostname
        ask BYRO_DB_PORT "Database port" "5432" valid_port
        ask BYRO_DB_NAME "Database name" "byro"
        ask BYRO_DB_USER "Database user" "byro"
        ask_secret BYRO_DB_PASS BYROCTL_DB_PASSWORD "Database password"
    fi
    ask BYROCTL_MAIL "Outgoing mail: host (mail server on this machine), smtp (external SMTP server), skip (configure later)" "skip" valid_mail_mode
    case "${BYROCTL_MAIL:-skip}" in
        host)
            BYRO_MAIL_HOST=host.docker.internal; BYRO_MAIL_PORT=25; BYRO_MAIL_TLS=false; BYRO_MAIL_SSL=false
            ask BYRO_MAIL_FROM "Sender address" "" valid_email ;;
        smtp)
            ask BYRO_MAIL_HOST "SMTP host" "" valid_hostname
            ask BYRO_MAIL_PORT "SMTP port" "587" valid_port
            ask BYRO_MAIL_USER "SMTP user" ""
            ask_secret BYRO_MAIL_PASSWORD BYROCTL_MAIL_PASSWORD "SMTP password"
            ask BYRO_MAIL_FROM "Sender address" "" valid_email
            ask BYRO_MAIL_TLS "Use STARTTLS (true/false)" "true" valid_bool
            ask BYRO_MAIL_SSL "Use implicit TLS/SSL (true/false)" "false" valid_bool ;;
    esac
    # Catalog short names only: a free pip requirement may contain spaces and is
    # given with --plugin instead. "none" keeps the question answerable without
    # input in both modes.
    if (( ${#INSTALL_PLUGINS[@]} == 0 )); then
        ask BYROCTL_PLUGINS "Additional plugins (catalog names, space separated, see: byroctl plugin list; none = no plugins)" "none" valid_plugin_names
        if [[ "${BYROCTL_PLUGINS:-none}" != none ]]; then
            read -r -a INSTALL_PLUGINS <<<"$BYROCTL_PLUGINS"
        fi
    fi
    ask BYRO_DEPLOY_PORT "Local port for the web service" "8345" valid_port
    ask BYRO_DEPLOY_BIND "Bind address for the web service" "127.0.0.1"
    ask COMPOSE_PROJECT_NAME "Compose project name" "byro" valid_project

    if (( ${#MISSING[@]} > 0 )); then
        die "missing values for a non-interactive installation: ${MISSING[*]} (use --set KEY=VALUE, secrets via environment variables)"
    fi

    # Ports must be free before anything is written.
    local ports=("$BYRO_DEPLOY_PORT")
    [[ "$BYROCTL_PROXY" == caddy ]] && ports+=(80 443)
    check_ports_free "${ports[@]}"

    [[ "$BYROCTL_PROXY" == own ]] && trust_proxy=true
    compose_file="docker-compose.yml"
    [[ "$BYROCTL_DB" == internal ]] && compose_file+=":compose/postgres.yml"
    [[ "$BYROCTL_PROXY" == caddy ]] && compose_file+=":compose/caddy.yml"

    cp "$BYRO_ROOT/byro.conf.example" "$CONF_FILE"
    chmod 600 "$CONF_FILE"

    conf_set COMPOSE_PROJECT_NAME "$COMPOSE_PROJECT_NAME"
    conf_set COMPOSE_FILE "$compose_file"
    conf_set BYRO_DEPLOY_VERSION "$version"
    conf_set BYRO_DEPLOY_PORT "$BYRO_DEPLOY_PORT"
    conf_set BYRO_DEPLOY_BIND "$BYRO_DEPLOY_BIND"
    conf_set BYRO_SITE_URL "$BYRO_SITE_URL"
    conf_set BYRO_HTTPS "$https"
    conf_set BYRO_TRUST_PROXY "$trust_proxy"
    conf_set BYRO_LANGUAGE_CODE "$BYRO_LANGUAGE_CODE"
    conf_set BYRO_TIME_ZONE "$BYRO_TIME_ZONE"
    if [[ "$BYROCTL_DB" == internal ]]; then
        conf_set BYRO_DB_HOST db
        conf_set BYRO_DB_PORT 5432
        conf_set BYRO_DB_NAME byro
        conf_set BYRO_DB_USER byro
        conf_set BYRO_DB_PASS "$(gen_password)"
    else
        conf_set BYRO_DB_HOST "$BYRO_DB_HOST"
        conf_set BYRO_DB_PORT "$BYRO_DB_PORT"
        conf_set BYRO_DB_NAME "$BYRO_DB_NAME"
        conf_set BYRO_DB_USER "$BYRO_DB_USER"
        conf_set BYRO_DB_PASS "$BYRO_DB_PASS"
    fi
    case "${BYROCTL_MAIL:-skip}" in
        host|smtp)
            conf_set BYRO_MAIL_HOST "$BYRO_MAIL_HOST"
            conf_set BYRO_MAIL_PORT "$BYRO_MAIL_PORT"
            conf_set BYRO_MAIL_FROM "$BYRO_MAIL_FROM"
            conf_set BYRO_MAIL_TLS "$BYRO_MAIL_TLS"
            conf_set BYRO_MAIL_SSL "$BYRO_MAIL_SSL"
            if [[ -n "${BYRO_MAIL_USER:-}" ]]; then conf_set BYRO_MAIL_USER "$BYRO_MAIL_USER"; fi
            if [[ -n "${BYRO_MAIL_PASSWORD:-}" ]]; then conf_set BYRO_MAIL_PASSWORD "$BYRO_MAIL_PASSWORD"; fi ;;
    esac
    # further non-secret --set values are configuration keys as well
    for key in "${!PRESET[@]}"; do
        case "$key" in
            BYROCTL_*) ;;   # installer switches, not configuration
            *) conf_set "$key" "${PRESET[$key]}" ;;
        esac
    done
    ln -sfn byro.conf "$BYRO_ROOT/.env"
    log "wrote $CONF_FILE"
}

# ensure_superuser ADMIN_USER ADMIN_EMAIL: creates the first superuser unless one exists.
ensure_superuser() {
    local admin_user="$1" admin_email="$2" ADMIN_USER ADMIN_EMAIL ADMIN_PASSWORD
    if compose run --rm -T manage shell -c "import sys; from django.contrib.auth import get_user_model as g; sys.exit(0 if g().objects.filter(is_superuser=True).exists() else 1)" >/dev/null 2>&1; then
        log "a superuser exists already, skipping account creation"
        return 0
    fi
    if [[ -n "$admin_user" ]]; then PRESET[ADMIN_USER]="$admin_user"; fi
    if [[ -n "$admin_email" ]]; then PRESET[ADMIN_EMAIL]="$admin_email"; fi
    log "Creating the first administrator account."
    ask ADMIN_USER "Administrator user name" "admin" valid_username
    ask ADMIN_EMAIL "Administrator e-mail address" "" valid_email
    ask_secret ADMIN_PASSWORD BYROCTL_ADMIN_PASSWORD "Administrator password" confirm
    if (( ${#MISSING[@]} > 0 )); then
        die "missing values for the administrator account: ${MISSING[*]} (--admin-user, --admin-email, BYROCTL_ADMIN_PASSWORD)"
    fi
    if ! DJANGO_SUPERUSER_PASSWORD="$ADMIN_PASSWORD" compose run --rm -T -e DJANGO_SUPERUSER_PASSWORD manage \
            createsuperuser --noinput --username "$ADMIN_USER" --email "$ADMIN_EMAIL"; then
        die "creating the administrator account failed (see the message above). Fix the input and run 'byroctl install' again; the installation resumes at this step."
    fi
    log "administrator account '$ADMIN_USER' created"
}

install_usage() {
    cat >&2 <<'USAGE'
Usage: byroctl install [options]

  --version TAG        byro release tag to install (set by install.sh)
  --set KEY=VALUE      preset an answer or configuration value (repeatable);
                       secrets are not accepted here, see below
  --admin-user NAME    user name of the first administrator
  --admin-email MAIL   e-mail address of the first administrator
  --skip-superuser     do not create an administrator account
  --plugin NAME|SPEC   install a plugin: a catalog short name (byroctl plugin list)
                       or a pip requirement such as 'pkg==1.2.3' or
                       'pkg @ git+https://host/repo.git@tag' (repeatable)
  --non-interactive    never prompt; fail if a required value is missing
  --no-pull            use the locally present image, never pull (development)

Secrets are read from the environment only: BYROCTL_ADMIN_PASSWORD,
BYROCTL_DB_PASSWORD (external database), BYROCTL_MAIL_PASSWORD,
BYROCTL_OIDC_CLIENT_SECRET.
Installer switches usable with --set: BYROCTL_PROXY=caddy|own|none,
BYROCTL_DB=internal|external, BYROCTL_MAIL=host|smtp|skip,
BYROCTL_PLUGINS="name name..." (catalog short names, or none).
USAGE
}

# install_missing_artifacts TAG: on a resumed installation only fetch what is absent.
install_missing_artifacts() {
    local tag="$1" relpath missing=0
    for relpath in "${BYROCTL_ARTIFACTS[@]}"; do
        [[ -f "$BYRO_ROOT/$relpath" ]] || missing=1
    done
    if (( missing )); then
        install_artifacts "$tag"
    fi
}

cmd_install() {
    local no_pull=0 skip_superuser=0 version="" admin_user="" admin_email="" repo ref digest configured site_url now
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --non-interactive) NONINTERACTIVE=1; shift ;;
            --no-pull) no_pull=1; shift ;;
            --skip-superuser) skip_superuser=1; shift ;;
            --version) [[ $# -ge 2 ]] || die "--version needs a tag" 64; version="$2"; shift 2 ;;
            --version=*) version="${1#--version=}"; shift ;;
            --admin-user) [[ $# -ge 2 ]] || die "--admin-user needs a value" 64; admin_user="$2"; shift 2 ;;
            --admin-email) [[ $# -ge 2 ]] || die "--admin-email needs a value" 64; admin_email="$2"; shift 2 ;;
            --set) [[ $# -ge 2 ]] || die "--set needs KEY=VALUE" 64; add_preset "$2"; shift 2 ;;
            --set=*) add_preset "${1#--set=}"; shift ;;
            --plugin) [[ $# -ge 2 ]] || die "--plugin needs a catalog name or a pip requirement" 64; add_install_plugin "$2"; shift 2 ;;
            --plugin=*) add_install_plugin "${1#--plugin=}"; shift ;;
            -h|--help) install_usage; exit 0 ;;
            *) die "unknown install option: $1 (see byroctl install --help)" 64 ;;
        esac
    done

    ensure_root_dir
    cd "$BYRO_ROOT"
    acquire_lock
    preflight_install

    if [[ -f "$CONF_FILE" ]]; then
        configured="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
        [[ -n "$configured" ]] || die "$CONF_FILE has no BYRO_DEPLOY_VERSION; set it with: byroctl config set BYRO_DEPLOY_VERSION <tag>"
        if [[ -n "$version" && "$version" != "$configured" ]]; then
            warn "ignoring --version $version: byro.conf pins $configured (use byroctl update to change the version)"
        fi
        version="$configured"
        log "byro.conf exists - resuming the installation for byro $version (use 'byroctl config' to change settings)"
        install_missing_artifacts "$version"
        ln -sfn byro.conf "$BYRO_ROOT/.env"
    else
        [[ -n "$version" ]] || die "no byro version given. install.sh passes --version <tag>; when running byroctl directly use --version vYYYY.M.P"
        if [[ -z "$BYROCTL_SOURCE_DIR" ]]; then
            valid_version "$version" || die "invalid byro release tag: $version (expected vYYYY.M.P)"
        else
            valid_tag "$version" || die "invalid image tag: $version"
        fi
        collect_config "$version"
    fi
    if [[ -n "${BYROCTL_OIDC_CLIENT_SECRET:-}" ]]; then
        conf_set BYRO_OIDC_CLIENT_SECRET "$BYROCTL_OIDC_CLIENT_SECRET"
    fi
    mkdir -p data db caddy backups .byroctl

    # --- plugins: the list now, the image once the base image is present. On a
    # resumed run entries that are already listed are skipped.
    plugins_init
    if (( ${#INSTALL_PLUGINS[@]} > 0 )); then
        plugins_add_entries "${INSTALL_PLUGINS[@]}" || true
    fi
    if plugins_configured; then
        compose_file_add "$PLUGINS_COMPOSE"
    else
        compose_file_remove "$PLUGINS_COMPOSE"
    fi

    # --- image
    repo="$(conf_get BYRO_DEPLOY_IMAGE_REPO 2>/dev/null || true)"
    repo="${repo:-$BYROCTL_DEFAULT_REPO}"
    ref="$repo:$version"
    digest="$(conf_get BYRO_DEPLOY_IMAGE_DIGEST 2>/dev/null || true)"
    if (( no_pull )); then
        image_local "$ref" || die "--no-pull: image $ref is not present locally. Build or load it first, or run without --no-pull."
        log "using the local image $ref (--no-pull); the digest stays ${digest:-unpinned}"
    elif [[ -z "$digest" ]]; then
        image_exists "$ref" || die "image $ref does not exist in the registry (is $version a published byro release?)"
        log "pulling images for byro $version ..."
        pull_images "$ref"
        digest="$(image_digest "$repo" "$ref")"
        [[ -n "$digest" ]] || die "the pulled image $ref carries no digest for $repo; refusing to continue without a pin"
        valid_digest "$digest" || die "unexpected digest format: $digest"
        conf_set BYRO_DEPLOY_IMAGE_DIGEST "$digest"
        log "pinned image digest $digest"
    else
        log "image is pinned to $digest; making sure all images are present ..."
        pull_images "$ref"
    fi

    # --- plugin image (before the first migration, so that it includes the
    # plugins' migrations)
    if plugins_configured; then
        need_buildx
        log "building the byro image with plugins ($(plugins_image)) ..."
        compose build web || die "building the image with plugins failed (see above). Fix plugins/plugins.txt or remove the entry (byroctl plugin remove NAME), then run 'byroctl install' again; the installation resumes here."
    fi

    # --- database and schema
    if compose_file_active compose/postgres.yml; then
        log "starting the database ..."
        compose up -d db
        wait_healthy db "$BYROCTL_DB_HEALTH_TIMEOUT" || die "the database did not become healthy"
    fi
    log "applying database migrations ..."
    compose run --rm -T manage migrate --noinput

    # --- administrator
    if (( skip_superuser )); then
        log "skipping the administrator account (--skip-superuser)"
    else
        ensure_superuser "$admin_user" "$admin_email"
    fi

    # --- start
    log "starting byro ..."
    compose up -d
    wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || die "byro did not become healthy; check 'byroctl logs web'"

    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if ! conf_has BYROCTL_INSTALLED_AT "$BYRO_ROOT/.byroctl/state"; then
        write_state BYROCTL_INSTALLED_AT "$now"
    fi
    write_state BYROCTL_LAST_INSTALL_RUN "$now"

    site_url="$(conf_get BYRO_SITE_URL 2>/dev/null || true)"
    cat <<SUMMARY

byro $version is installed and running.

  URL:            ${site_url:-unknown}
  directory:      $BYRO_ROOT
  configuration:  $CONF_FILE  (change with: byroctl config set KEY VALUE --apply)
  plugins:        $(plugin_summary)  (manage with: byroctl plugin list|add|remove|update)

Back up regularly: $BYRO_ROOT/data (documents, keys, .secret), $BYRO_ROOT/db (database)
or your external database, $BYRO_ROOT/byro.conf and $BYRO_ROOT/plugins.
SUMMARY
}

# --- config, start, stop, restart, logs, manage --------------------------------------------

# enter_root: all commands except install need an existing installation.
enter_root() {
    [[ -d "$BYRO_ROOT" ]] || die "installation directory $BYRO_ROOT does not exist (run byroctl install first)"
    cd "$BYRO_ROOT"
    [[ -f "$CONF_FILE" ]] || die "no byro.conf in $BYRO_ROOT - not installed yet? (run byroctl install)"
}

# file_mode FILE: octal permission bits, GNU and BSD stat.
file_mode() {
    stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true
}

# conf_lint_value KEY RAW: returns 1 and prints a reason if the raw file value
# would be misread by Docker Compose.
conf_lint_value() {
    local key="$1" raw="$2" q="'"
    if [[ "$raw" == "$q"* ]]; then
        if [[ ${#raw} -lt 2 || "$raw" != *"$q" ]]; then
            printf '%s: single-quoted value is not closed\n' "$key"; return 1
        fi
    elif [[ "$raw" == '"'* ]]; then
        if [[ "$raw" == *'$'* ]]; then
            printf '%s: double quotes do not protect $ from Compose interpolation, use single quotes\n' "$key"; return 1
        fi
    else
        if [[ "$raw" == *'$'* ]]; then
            printf '%s: unquoted value contains $ and would be interpolated by Compose, use single quotes\n' "$key"; return 1
        fi
        if [[ "$raw" =~ [[:space:]]# ]]; then
            printf '%s: unquoted value contains " #", the rest would be treated as a comment, use single quotes\n' "$key"; return 1
        fi
        if [[ "$raw" == *"$q"* ]]; then
            printf '%s: unquoted value contains an apostrophe, use single quotes (apostrophe inside as backslash-apostrophe)\n' "$key"; return 1
        fi
    fi
    return 0
}

# config_check: validates byro.conf and the compose configuration. Prints every
# problem, returns 1 if any error was found.
config_check() {
    local errors=0 warnings=0 line key raw mode f value repo digest version
    err()  { printf 'byroctl: config check: ERROR: %s\n' "$*" >&2; errors=$((errors + 1)); }
    note() { printf 'byroctl: config check: warning: %s\n' "$*" >&2; warnings=$((warnings + 1)); }

    [[ -f "$CONF_FILE" ]] || { err "$CONF_FILE does not exist"; return 1; }
    mode="$(file_mode "$CONF_FILE")"
    [[ "$mode" == 600 ]] || err "$CONF_FILE has mode $mode, it contains passwords and must be 600 (chmod 600 byro.conf)"
    [[ -L "$BYRO_ROOT/.env" || -f "$BYRO_ROOT/.env" ]] || err ".env is missing; docker compose needs it: ln -s byro.conf .env"

    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^[A-Z][A-Z0-9_]*= ]] || continue
        key="${line%%=*}"; raw="${line#*=}"
        if ! value="$(conf_lint_value "$key" "$raw")"; then
            err "$value"
        fi
    done <"$CONF_FILE"

    version="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
    [[ -n "$version" ]] || err "BYRO_DEPLOY_VERSION is empty"
    value="$(conf_get BYRO_SITE_URL 2>/dev/null || true)"
    if [[ -z "$value" ]]; then
        err "BYRO_SITE_URL is empty"
    elif ! valid_url "$value"; then
        err "BYRO_SITE_URL must be http(s)://host[:port] without a path (got: $value)"
    fi
    if compose_file_active compose/postgres.yml && ! conf_has BYRO_DB_PASS; then
        err "BYRO_DB_PASS is empty but the built-in database (compose/postgres.yml) is active"
    fi
    while IFS= read -r f; do
        [[ -n "$f" ]] || continue
        [[ -f "$BYRO_ROOT/$f" ]] || err "COMPOSE_FILE names $f, but the file does not exist in $BYRO_ROOT"
    done < <(compose_files)
    if [[ -f "$PLUGINS_FILE" ]] && ! plugins_lint; then
        err "plugins/plugins.txt has invalid entries (see above)"
    fi
    if plugins_configured && ! compose_file_active "$PLUGINS_COMPOSE"; then
        err "plugins/plugins.txt names plugins, but COMPOSE_FILE does not include $PLUGINS_COMPOSE; run byroctl plugin rebuild"
    elif ! plugins_configured && compose_file_active "$PLUGINS_COMPOSE"; then
        err "COMPOSE_FILE includes $PLUGINS_COMPOSE, but plugins/plugins.txt names no plugin; run byroctl plugin rebuild"
    fi
    if conf_has BYRO_DEBUG; then
        note "BYRO_DEBUG is set - never run a production instance in debug mode"
    fi
    digest="$(conf_get BYRO_DEPLOY_IMAGE_DIGEST 2>/dev/null || true)"
    if [[ -n "$digest" ]]; then
        if ! valid_digest "$digest"; then
            err "BYRO_DEPLOY_IMAGE_DIGEST has an unexpected format (expected sha256:<64 hex>): $digest"
        elif command -v docker >/dev/null 2>&1; then
            repo="$(conf_get BYRO_DEPLOY_IMAGE_REPO 2>/dev/null || true)"
            repo="${repo:-$BYROCTL_DEFAULT_REPO}"
            if ! image_exists "$repo@$digest"; then
                note "could not confirm $repo@$digest in the registry (offline, or the digest is unknown there)"
            fi
        fi
    fi
    if command -v docker >/dev/null 2>&1; then
        if ! compose config -q 2>"$BYRO_ROOT/.byroctl/compose-check.log"; then
            err "docker compose config failed:"
            sed 's/^/    /' "$BYRO_ROOT/.byroctl/compose-check.log" >&2 || true
        fi
        rm -f "$BYRO_ROOT/.byroctl/compose-check.log"
    fi

    if (( errors > 0 )); then
        log "config check: $errors error(s), $warnings warning(s)"
        return 1
    fi
    log "config check: OK ($warnings warning(s))"
    return 0
}

cmd_config() {
    local sub="${1:-}" key value apply=0 arg editor
    [[ -n "$sub" ]] || die "usage: byroctl config get KEY | set KEY VALUE [--apply] | edit | check" 64
    shift
    enter_root
    case "$sub" in
        get)
            key="${1:-}"; [[ -n "$key" ]] || die "usage: byroctl config get KEY" 64
            valid_conf_key "$key" || die "invalid key: $key" 64
            value="$(conf_get "$key")" || die "$key is not set in $CONF_FILE"
            printf '%s\n' "$(conf_mask "$key" "$value")" ;;
        set)
            key="${1:-}"; [[ -n "$key" ]] || die "usage: byroctl config set KEY VALUE [--apply] (secrets: BYROCTL_VALUE=... byroctl config set KEY --apply)" 64
            valid_conf_key "$key" || die "invalid key: $key" 64
            shift
            value=""; local have_value=0
            for arg in "$@"; do
                case "$arg" in
                    --apply) apply=1 ;;
                    *) if (( have_value )); then die "too many arguments for config set" 64; fi; value="$arg"; have_value=1 ;;
                esac
            done
            if is_secret_key "$key"; then
                (( have_value == 0 )) || die "$key is a secret; do not pass it on the command line. Use: BYROCTL_VALUE='...' byroctl config set $key" 64
                [[ -n "${BYROCTL_VALUE:-}" ]] || die "$key is a secret; provide it in the environment variable BYROCTL_VALUE" 64
                value="$BYROCTL_VALUE"
            else
                (( have_value )) || die "usage: byroctl config set KEY VALUE [--apply]" 64
            fi
            acquire_lock
            conf_set "$key" "$value"
            log "set $key=$(conf_mask "$key" "$value")"
            if (( apply )); then
                config_check || die "not applying a configuration with errors"
                need_docker
                log "applying: docker compose up -d"
                compose up -d
                wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || die "byro did not become healthy after the change; check 'byroctl logs web'"
            else
                log "run 'byroctl config check' and 'byroctl start' (docker compose up -d) to apply"
            fi ;;
        edit)
            editor="${EDITOR:-nano}"
            command -v "${editor%% *}" >/dev/null 2>&1 || die "editor '$editor' not found; set EDITOR"
            acquire_lock
            $editor "$CONF_FILE"
            chmod 600 "$CONF_FILE"
            config_check || die "fix the errors above (byroctl config edit)"
            if confirm "Apply the configuration now (docker compose up -d)?" y; then
                need_docker
                compose up -d
                wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || die "byro did not become healthy; check 'byroctl logs web'"
            fi ;;
        check)
            config_check ;;
        *)
            die "unknown config subcommand: $sub (get | set | edit | check)" 64 ;;
    esac
}

cmd_start() {
    enter_root; need_docker; acquire_lock
    log "starting: docker compose up -d"
    compose up -d
    wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || die "byro did not become healthy; check 'byroctl logs web'"
    log "byro is up"
}

cmd_stop() {
    enter_root; need_docker; acquire_lock
    log "stopping the stack (containers and data are kept)"
    compose stop
}

# restart: recreate the byro services only. The database keeps running, the
# manage service is a profile-only one-off.
cmd_restart() {
    local services=() s
    enter_root; need_docker; acquire_lock
    while IFS= read -r s; do
        [[ -n "$s" ]] || continue
        case "$s" in db|manage) ;; *) services+=("$s") ;; esac
    done < <(active_services)
    (( ${#services[@]} > 0 )) || die "no services found in the compose configuration"
    log "recreating: ${services[*]}"
    compose up -d --force-recreate --no-deps "${services[@]}"
    wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || die "byro did not become healthy; check 'byroctl logs web'"
}

cmd_logs() {
    local follow=() arg services=()
    enter_root; need_docker
    for arg in "$@"; do
        case "$arg" in
            -f|--follow) follow=(--follow) ;;
            -*) die "unknown logs option: $arg (byroctl logs [-f] [SERVICE...])" 64 ;;
            *) services+=("$arg") ;;
        esac
    done
    compose logs --tail=200 "${follow[@]}" "${services[@]}"
}

cmd_manage() {
    local tty=()
    enter_root; need_docker
    [[ $# -gt 0 ]] || die "usage: byroctl manage <django command> [args...]" 64
    [[ -t 0 && -t 1 ]] || tty=(-T)
    compose run --rm "${tty[@]}" manage "$@"
}

# --- plugins --------------------------------------------------------------------------------
#
# Plugins are pip requirements in plugins/plugins.txt, installed into a derived
# image that plugins/Dockerfile builds on top of the pinned release image;
# compose/plugins.yml switches web, periodic and manage to that image while the
# list names at least one plugin. A catalog entry (plugin-catalog.conf, metadata
# only) is resolved to a pin when it is added: the current GitHub release by the
# commit its tag points to, or the current PyPI release with ==. Such a line ends
# in "# byroctl:catalog=NAME version=V".
#
# Every change runs in two phases. Phase 1 (build, manage check) is reversible:
# on failure the previous plugins.txt, COMPOSE_FILE and image come back. Then a
# pre-plugin safeguard is written, and phase 2 (migrate, recreate) is not
# reversed automatically: a database that may already carry the new plugins'
# schema is never combined with the old code by byroctl; plugin_recovery_hint
# explains the way forward and the way back.

# --- catalog: [shortname] sections with key=value lines; default file in BYRO_ROOT
catalog_file() { printf '%s' "${1:-$BYRO_ROOT/plugin-catalog.conf}"; }
# catalog_names [FILE]: byroctl always uses the default file, the tests pass one
# shellcheck disable=SC2120
catalog_names() {
    local file; file="$(catalog_file "${1:-}")"
    [[ -f "$file" ]] || return 0
    grep -oE '^\[[a-z0-9-]+\]$' "$file" | tr -d '[]' || true
}
catalog_has() {
    local file; file="$(catalog_file "${2:-}")"
    [[ -f "$file" ]] && grep -qxF "[$1]" "$file"
}
# catalog_field NAME KEY [FILE]: the raw value, empty if absent (values may contain "=")
catalog_field() {
    local file; file="$(catalog_file "${3:-}")"
    [[ -f "$file" ]] || return 0
    awk -v s="[$1]" -v k="$2" '
        $0 == s { f = 1; next }
        /^\[/  { f = 0 }
        f && index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }
    ' "$file"
}

# valid_plugin_names VALUE: "none" or catalog short names separated by spaces
valid_plugin_names() {
    local n
    [[ "$1" == none ]] && return 0
    for n in $1; do
        if ! valid_plugin_name "$n" || ! catalog_has "$n"; then
            printf 'byroctl: %s is not a catalog plugin; known: %s\n' "$n" "$(catalog_names | tr '\n' ' ')" >&2
            return 1
        fi
    done
}

# add_install_plugin ARG: collect a --plugin argument (catalog name or requirement)
add_install_plugin() {
    valid_plugin_name "$1" || valid_plugin_spec "$1" \
        || die "--plugin: not a catalog name or a usable pip requirement: $1 (no pip options, no #, \$, ; or backslash)" 64
    INSTALL_PLUGINS+=("$1")
}

# --- version resolution (https only; api.github.com gets GITHUB_TOKEN when set)
fetch_url() { # URL DEST [ACCEPT]
    local url="$1" dest="$2" accept="${3:-application/json}"
    local headers=(-H "Accept: $accept")
    require_https "$url" "URL"
    if [[ "$url" == https://api.github.com/* && -n "${GITHUB_TOKEN:-}" ]]; then
        headers+=(-H "Authorization: Bearer $GITHUB_TOKEN")
    fi
    curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 "${headers[@]}" -o "$dest" "$url"
}

# github_repo_path URL: owner/repo from https://github.com/owner/repo[.git]
github_repo_path() {
    local path="${1#https://github.com/}"
    path="${path%/}"; path="${path%.git}"
    [[ "$path" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
    printf '%s' "$path"
}

# resolve_github_release REPO_URL: "SHA<TAB>TAG" of the current regular release
# (GitHub's releases/latest excludes pre-releases and drafts). The tag name is a
# deliberately minimal grep over the JSON; the commit comes as plain text from the
# commits endpoint with the sha media type (annotated tags are peeled).
resolve_github_release() {
    local repo_url="$1" path tmp tag sha
    path="$(github_repo_path "$repo_url")" || die "not a GitHub repository URL: $repo_url"
    tmp="$(mktemp)"
    if ! fetch_url "https://api.github.com/repos/$path/releases/latest" "$tmp" "application/vnd.github+json" 2>/dev/null; then
        rm -f "$tmp"
        die "$path has no GitHub release yet, or api.github.com is not reachable. Ask the maintainer to publish a release, or give an explicit requirement such as '<package> @ git+https://github.com/$path.git@<ref>'"
    fi
    tag="$(grep -oE '"tag_name": *"[^"]+"' "$tmp" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
    rm -f "$tmp"
    valid_tag "$tag" || die "the current release of $path has no usable tag name (got: ${tag:-nothing})"
    case "$tag" in
        main|master|HEAD|develop|trunk) die "the current release of $path is named $tag, a branch name, not a release tag" ;;
    esac
    tmp="$(mktemp)"
    if ! fetch_url "https://api.github.com/repos/$path/commits/$tag" "$tmp" "application/vnd.github.sha" 2>/dev/null; then
        rm -f "$tmp"
        die "cannot resolve the commit of release $tag in $path"
    fi
    sha="$(tr -d '[:space:]' <"$tmp")"
    rm -f "$tmp"
    valid_commit_sha "$sha" || die "unexpected commit id for release $tag of $path: $sha"
    printf '%s\t%s' "$sha" "$tag"
}

# resolve_pypi_release PACKAGE: the current release version on PyPI. The first
# "version" key of the JSON document is info.version (the info object comes
# before releases and urls; quotes inside description strings are escaped).
resolve_pypi_release() {
    local package="$1" tmp version
    tmp="$(mktemp)"
    if ! fetch_url "https://pypi.org/pypi/$package/json" "$tmp" 2>/dev/null; then
        rm -f "$tmp"
        die "$package is not on PyPI, or pypi.org is not reachable"
    fi
    version="$(grep -oE '"version": *"[^"]+"' "$tmp" | head -n1 | sed -E 's/.*"([^"]+)"$/\1/' || true)"
    rm -f "$tmp"
    [[ "$version" =~ ^[0-9][A-Za-z0-9.!+-]*$ ]] || die "PyPI reports no usable version for $package (got: ${version:-nothing})"
    printf '%s' "$version"
}

# --- plugins.txt
plugins_init() {
    mkdir -p "$BYRO_ROOT/plugins"
    if [[ ! -f "$PLUGINS_FILE" ]]; then
        cat >"$PLUGINS_FILE" <<'EOF'
# byro plugins: one pip requirement per line. A catalog entry is pinned by
# byroctl (byroctl plugin add NAME); explicit entries look like "name==1.2.3",
# "name @ git+https://host/repo.git@ref" or "./directory" for a checkout inside
# plugins/. After editing by hand run: byroctl plugin rebuild
EOF
    fi
}

# The awk program behind plugin_entries: SPEC<TAB>NAME<TAB>VERSION per active
# line. Comments follow pip's rule (a "#" at the start or after whitespace),
# NAME and VERSION come from byroctl's marker "# byroctl:catalog=NAME version=V".
# shellcheck disable=SC2016  # an awk program, not shell expansions
PLUGIN_ENTRY_AWK='
    {
        line = $0; name = ""; version = ""
        if (match(line, /(^|[ \t])#.*$/)) {
            comment = substr(line, RSTART, RLENGTH)
            line = substr(line, 1, RSTART - 1)
            if (match(comment, /byroctl:catalog=[^ \t]+/)) name = substr(comment, RSTART + 16, RLENGTH - 16)
            if (match(comment, /version=[^ \t]+/)) version = substr(comment, RSTART + 8, RLENGTH - 8)
        }
        gsub(/^[ \t]+|[ \t]+$/, "", line)
        if (line != "") printf "%s\t%s\t%s\n", line, name, version
    }'
plugin_entries() {
    [[ -f "$PLUGINS_FILE" ]] || return 0
    awk "$PLUGIN_ENTRY_AWK" "$PLUGINS_FILE"
}
plugin_parse_line() { awk "$PLUGIN_ENTRY_AWK" <<<"$1"; }   # one raw line -> entry or nothing
entry_spec()    { printf '%s' "${1%%$'\t'*}"; }
entry_name()    { local r="${1#*$'\t'}"; printf '%s' "${r%%$'\t'*}"; }
entry_version() { printf '%s' "${1##*$'\t'}"; }
# entry_label ENTRY: "finance-import-bank-files v1.2.0 (byro-finance-import-bank-files @ git+...)" or the bare requirement
entry_label() {
    local name; name="$(entry_name "$1")"
    if [[ -n "$name" ]]; then printf '%s %s (%s)' "$name" "$(entry_version "$1")" "$(entry_spec "$1")"; else entry_spec "$1"; fi
}
plugin_specs() { plugin_entries | cut -f1; }
plugins_configured() { [[ -n "$(plugin_specs)" ]]; }
plugins_image() {
    local project version
    project="$(conf_get COMPOSE_PROJECT_NAME 2>/dev/null || true)"
    version="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
    printf '%s-plugins:%s' "${project:-byro}" "$version"
}
plugin_line() { # SPEC NAME VERSION
    if [[ -n "$2" ]]; then printf '%s  # byroctl:catalog=%s version=%s\n' "$1" "$2" "$3"; else printf '%s\n' "$1"; fi
}
# spec_project SPEC: the (normalized) project name of a requirement, or the path
spec_project() {
    local s="$1"
    s="${s%%[\[<>=!~\ @]*}"
    printf '%s' "$s" | tr 'A-Z_.' 'a-z--'
}
# plugin_summary: "none" or "finance-import-bank-files v1.2.0, byro-x==1.0, ./local"
plugin_summary() {
    local entry name out=""
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        name="$(entry_name "$entry")"
        if [[ -n "$name" ]]; then
            out+="${out:+, }$name $(entry_version "$entry")"
        else
            out+="${out:+, }$(entry_spec "$entry")"
        fi
    done < <(plugin_entries)
    printf '%s' "${out:-none}"
}
# plugin_installed_version NAME: the pinned version of a catalog entry, or nothing
plugin_installed_version() {
    local entry
    while IFS= read -r entry; do
        [[ "$(entry_name "$entry")" == "$1" ]] || continue
        printf '%s' "$(entry_version "$entry")"
        return 0
    done < <(plugin_entries)
    return 1
}
# entry_matches ENTRY ARG: by catalog name, exact requirement or project name
entry_matches() {
    local spec; spec="$(entry_spec "$1")"
    [[ "$spec" == "$2" || "$(entry_name "$1")" == "$2" ]] && return 0
    [[ "$(spec_project "$spec")" == "$(spec_project "$2")" ]]
}
plugins_lint() {
    local entry ok=0
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        if ! valid_plugin_spec "$(entry_spec "$entry")"; then
            printf 'byroctl: plugins/plugins.txt: invalid line: %s\n' "$(entry_spec "$entry")" >&2
            ok=1
        fi
    done < <(plugin_entries)
    return $ok
}

# plugin_resolve ARG [CATALOG]: SPEC<TAB>NAME<TAB>VERSION. A catalog short name is
# resolved through the plugin's source (decision: the current release, whether
# it fits the installed byro is decided by the build); anything else is an
# explicit pip requirement and is only sanity-checked.
plugin_resolve() {
    local arg="$1" catalog="${2:-}" package source repo resolved sha tag version
    if valid_plugin_name "$arg" && catalog_has "$arg" "$catalog"; then
        package="$(catalog_field "$arg" package "$catalog")"
        source="$(catalog_field "$arg" source "$catalog")"
        repo="$(catalog_field "$arg" repo "$catalog")"
        [[ -n "$package" && -n "$source" && -n "$repo" ]] || die "catalog entry [$arg] is incomplete (package, source, repo)"
        case "$source" in
            github)
                log "resolving the current release of $package from $repo ..."
                # "|| exit": a command substitution does not inherit set -e, so a
                # die() inside the resolver must be propagated by hand
                resolved="$(resolve_github_release "$repo")" || exit $?
                sha="${resolved%%$'\t'*}"; tag="${resolved#*$'\t'}"
                printf '%s @ git+https://github.com/%s.git@%s\t%s\t%s' "$package" "$(github_repo_path "$repo")" "$sha" "$arg" "$tag" ;;
            pypi)
                log "resolving the current release of $package on PyPI ..."
                version="$(resolve_pypi_release "$package")" || exit $?
                printf '%s==%s\t%s\t%s' "$package" "$version" "$arg" "$version" ;;
            *) die "catalog entry [$arg] has an unknown source: $source" ;;
        esac
        return 0
    fi
    if valid_plugin_name "$arg"; then
        die "$arg is not in the plugin catalog (byroctl plugin list). For a package outside the catalog give a pinned requirement, e.g. '$arg==1.2.3' or '$arg @ git+https://host/repo.git@<tag>'" 64
    fi
    valid_plugin_spec "$arg" || die "invalid plugin requirement: $arg (no pip options, no #, \$, ; or backslash)" 64
    plugin_spec_pinned "$arg" || warn "$arg is not pinned to a version; a rebuild may pick a different release of it"
    printf '%s\t\t' "$arg"
}

# plugins_prepare_add ARG...: resolve and check everything, print the new entries
# (nothing is written here). Already listed entries are skipped with a note; the
# same project with a different requirement is refused.
plugins_prepare_add() {
    local arg resolved spec name project existing new_entries=() e
    for arg in "$@"; do
        resolved="$(plugin_resolve "$arg")" || exit $?
        spec="$(entry_spec "$resolved")"; name="$(entry_name "$resolved")"
        if [[ -n "$name" ]] && plugin_installed_version "$name" >/dev/null; then
            log "already listed: $name $(plugin_installed_version "$name")"
            continue
        fi
        project="$(spec_project "$spec")"
        while IFS= read -r existing; do
            [[ -n "$existing" ]] || continue
            [[ "$(entry_spec "$existing")" == "$spec" ]] && { log "already listed: $spec"; continue 2; }
            [[ "$(spec_project "$(entry_spec "$existing")")" == "$project" ]] \
                && die "$project is already listed with a different requirement ($(entry_spec "$existing")); remove it first: byroctl plugin remove $project" 64
        done < <(plugin_entries)
        for e in "${new_entries[@]}"; do
            [[ "$(spec_project "$(entry_spec "$e")")" == "$project" ]] && die "$project is given twice with different requirements" 64
        done
        new_entries+=("$resolved")
    done
    (( ${#new_entries[@]} == 0 )) || printf '%s\n' "${new_entries[@]}"
}
# plugins_add_entries ARG...: prepare, then append; returns 1 if nothing was new
plugins_add_entries() {
    local prepared entry
    prepared="$(plugins_prepare_add "$@")" || exit $?
    [[ -n "$prepared" ]] || return 1
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        plugin_line "$(entry_spec "$entry")" "$(entry_name "$entry")" "$(entry_version "$entry")" >>"$PLUGINS_FILE"
        log "added $(entry_label "$entry")"
    done <<<"$prepared"
}

# --- snapshot, apply, revert
PLUGIN_SNAPSHOT=""   # removed by release_lock if a command dies before consuming it

# plugins_snapshot [APPLIED_FILE]: the state before a change, for the revert of
# phase 1 and for the safeguard at the phase boundary. Without an argument the
# current plugins.txt is the previous state; with a file that file is (rebuild
# passes the list the running image was built from); an empty argument records
# that no previously applied plugin state existed.
plugins_snapshot() {
    local dir
    dir="$(mktemp -d "$BYRO_ROOT/.byroctl/plugin-snapshot.XXXXXX")"
    cp "$CONF_FILE" "$dir/byro.conf"
    chmod 600 "$dir/byro.conf"
    if (( $# == 0 )); then
        cp "$PLUGINS_FILE" "$dir/plugins.txt"
    elif [[ -n "$1" ]]; then
        cp "$1" "$dir/plugins.txt"
    fi
    PLUGIN_SNAPSHOT="$dir"
    printf '%s' "$dir"
}

# plugins_applied_state DEST: the plugins.txt the running plugin image was built
# from (/byro/plugins.txt in the web container, else in the local plugin image);
# returns 1 when no previously applied plugin state exists.
plugins_applied_state() {
    local dest="$1" image
    image="$(plugins_image)"
    if compose_file_active "$PLUGINS_COMPOSE" && [[ -n "$(container_id web)" ]]; then
        if compose exec -T web cat /byro/plugins.txt >"$dest" 2>/dev/null; then return 0; fi
    fi
    if image_local "$image"; then
        if docker run --rm --entrypoint cat "$image" /byro/plugins.txt >"$dest" 2>/dev/null; then return 0; fi
    fi
    return 1
}

# plugins_build_and_check [--no-cache]: phase 1. Returns 1 on failure; nothing
# irreversible has happened then.
plugins_build_and_check() {
    local nocache=()
    [[ "${1:-}" == --no-cache ]] && nocache=(--no-cache)
    if plugins_configured; then
        compose_file_add "$PLUGINS_COMPOSE"
        log "building the byro image with plugins ($(plugins_image)) ..."
        compose build "${nocache[@]}" web || return 1
        log "checking the new image (manage check) ..."
        compose run --rm -T manage check || return 1
    else
        compose_file_remove "$PLUGINS_COMPOSE"
    fi
}

# plugins_migrate_and_start SNAPSHOT SKIP_SAFEGUARD: the safeguard (still phase 1:
# a failure here returns 1 and is reverted), then phase 2. Returns 2 when the
# migration failed and 3 when the stack did not come back healthy.
plugins_migrate_and_start() {
    local snapshot="$1" skip="$2" version digest
    PLUGINS_SAFEGUARD=""
    if (( skip )); then
        warn "skipping the pre-plugin safeguard (--skip-safeguard)"
    else
        version="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
        digest="$(conf_get BYRO_DEPLOY_IMAGE_DIGEST 2>/dev/null || true)"
        if ! PLUGINS_SAFEGUARD="$(pre_update_safeguard "$version" "$digest" "$version" pre-plugin "$snapshot")"; then
            return 1
        fi
        log "safeguard written to $PLUGINS_SAFEGUARD"
    fi
    rm -rf "$snapshot"; PLUGIN_SNAPSHOT=""
    log "applying database migrations ..."
    compose run --rm -T manage migrate --noinput || return 2
    if [[ -n "$(container_id web)" ]]; then
        log "recreating the byro services with the new image ..."
        compose up -d || return 3
        wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT" || return 3
    else
        log "the stack is not running; start it with: byroctl start"
    fi
    return 0
}

# plugins_revert SNAPSHOT WAS_ACTIVE KEEP_LIST: after a phase 1 failure only
plugins_revert() {
    local snapshot="$1" was_active="$2" keep_list="$3"
    if (( ! keep_list )) && [[ -f "$snapshot/plugins.txt" ]]; then
        cp "$snapshot/plugins.txt" "$PLUGINS_FILE"
    fi
    cp "$snapshot/byro.conf" "$CONF_FILE"
    chmod 600 "$CONF_FILE"
    if (( was_active )); then
        log "restoring the previous plugin image from the build cache ..."
        compose build web >/dev/null 2>&1 \
            || warn "could not rebuild the previous plugin image; the running containers are unaffected, run byroctl plugin rebuild after fixing the cause"
    fi
    rm -rf "$snapshot"; PLUGIN_SNAPSHOT=""
}

# plugin_recovery_hint KIND(migrate|start) SAFEGUARD
plugin_recovery_hint() {
    local kind="$1" safeguard="$2"
    if [[ "$kind" == migrate ]]; then
        log "plugin migration failed; the database may already contain changes of the new plugin set."
    else
        log "web did not become healthy after the plugin change; the migration has run."
    fi
    log "  plugins/plugins.txt and COMPOSE_FILE keep the attempted state on purpose."
    log "  Do not switch back to the previous plugins by hand: the schema may no longer match their code."
    log "  Forward: read the error above and 'byroctl logs web', fix the cause, then: byroctl plugin rebuild"
    log "  Back:    1. restore ${safeguard:-the pre-plugin safeguard in $BYRO_ROOT/backups}: the database from db.dump (pg_restore),"
    log "              then byro.conf and plugins/plugins.txt from there (META says whether a previous plugin list existed)"
    log "           2. byroctl plugin rebuild"
    log "           3. byroctl start, then byroctl version (loaded plugins) and the health of web"
}

# plugins_finish SNAPSHOT WAS_ACTIVE KEEP_LIST SKIP_SAFEGUARD [--no-cache]: both
# phases with the agreed exits: 1 reverted, 2 migration failed, 3 start failed.
plugins_finish() {
    local snapshot="$1" was_active="$2" keep_list="$3" skip="$4" rc=0
    shift 4
    plugins_build_and_check "$@" || rc=1
    if (( rc == 0 )); then
        plugins_migrate_and_start "$snapshot" "$skip" || rc=$?
    fi
    case "$rc" in
        0)
            log "plugins now: $(plugin_summary)"
            return 0 ;;
        1)
            plugins_revert "$snapshot" "$was_active" "$keep_list"
            if (( keep_list )); then
                die "the plugin image could not be built or checked (see above). plugins/plugins.txt was kept as you edited it; COMPOSE_FILE is back to its previous state and the stack is unchanged. Fix the cause, then run byroctl plugin rebuild again." 1
            fi
            die "the plugin image could not be built or checked (see above); nothing was changed, the stack still runs the previous plugin set" 1 ;;
        2) plugin_recovery_hint migrate "$PLUGINS_SAFEGUARD"; exit 2 ;;
        *) plugin_recovery_hint start "$PLUGINS_SAFEGUARD"; exit 3 ;;
    esac
}

# plugins_resolve_updates TMP CATALOG [NAME...]: resolve every (or the named)
# catalog entries again and write the resulting list to TMP. Per entry: the same
# requirement -> unchanged; a new release -> updated; the same release tag now
# pointing to another commit -> integrity error. Returns 1 if any integrity
# error occurred (fail-closed: TMP must not be used), 3 if nothing changed, 0 if
# TMP carries changes.
plugins_resolve_updates() {
    local tmp="$1" catalog="${2:-}" line entry spec name version resolved new_spec new_version rc
    local -a filter=("${@:3}")
    local n changed=0 integrity=0
    for n in "${filter[@]}"; do
        plugin_installed_version "$n" >/dev/null || die "$n is not an installed catalog plugin (byroctl plugin list)" 64
    done
    : >"$tmp"
    while IFS= read -r line || [[ -n "$line" ]]; do
        entry="$(plugin_parse_line "$line")"
        name="$(entry_name "${entry:-$'\t\t'}")"
        if [[ -z "$entry" || -z "$name" ]]; then
            printf '%s\n' "$line" >>"$tmp"
            continue
        fi
        if (( ${#filter[@]} > 0 )) && [[ " ${filter[*]} " != *" $name "* ]]; then
            printf '%s\n' "$line" >>"$tmp"
            continue
        fi
        if ! catalog_has "$name" "$catalog"; then
            warn "$name is no longer in the plugin catalog; keeping the installed pin"
            printf '%s\n' "$line" >>"$tmp"
            continue
        fi
        spec="$(entry_spec "$entry")"; version="$(entry_version "$entry")"
        # this function runs in a "|| rc=$?" context where set -e is off: a
        # resolution failure (die inside) must end the command explicitly
        resolved="$(plugin_resolve "$name" "$catalog")" || { rc=$?; rm -f "$tmp"; exit "$rc"; }
        new_spec="$(entry_spec "$resolved")"; new_version="$(entry_version "$resolved")"
        if [[ "$new_spec" == "$spec" ]]; then
            log "$name: $version (current)"
            printf '%s\n' "$line" >>"$tmp"
        elif [[ "$new_version" == "$version" && "$spec" == *git+* && "$new_spec" == *git+* ]]; then
            printf 'byroctl: ERROR: %s: release %s now points to commit %s, the installed pin is %s. Published release tags are treated as immutable; byroctl keeps the installed pin. Ask the plugin maintainer to publish a new release for changed code.\n' \
                "$name" "$version" "${new_spec##*@}" "${spec##*@}" >&2
            printf '%s\n' "$line" >>"$tmp"
            integrity=1
        else
            log "$name: $version -> $new_version"
            plugin_line "$new_spec" "$name" "$new_version" >>"$tmp"
            changed=1
        fi
    done <"$PLUGINS_FILE"
    (( integrity == 0 )) || return 1
    (( changed )) || return 3
    return 0
}

plugin_usage() {
    cat >&2 <<'USAGE'
Usage: byroctl plugin <subcommand> [options]

  list                     the plugin catalog, what is installed, extra entries
  add NAME|SPEC...         add catalog plugins (short names) or pip requirements
                           ('pkg==1.2.3', 'pkg @ git+https://host/repo.git@tag',
                           './dir' for a checkout inside plugins/), then rebuild
  remove NAME|SPEC...      remove entries (database tables of a plugin are kept)
  update [--check] [NAME...]
                           move catalog plugins to their current release; --check
                           only reports (exit 0 changes, 3 none, 1 error)
  rebuild [--no-cache]     rebuild the image from plugins/plugins.txt (after
                           editing it by hand)

Options for add, remove, update, rebuild:
  --skip-safeguard         no pre-plugin safeguard (database dump, byro.conf,
                           previous plugins.txt, .secret) before the migration

Exit codes: 1 build, check, resolution or integrity error (nothing changed),
2 migration failed, 3 start or health check failed (see the recovery hint),
64 usage.
USAGE
}

plugin_list() {
    local name installed entry extras=() catalog
    catalog="$(catalog_file)"
    if [[ -f "$catalog" ]]; then
        printf '%-14s %-24s %-7s %-16s %s\n' NAME PACKAGE SOURCE INSTALLED DESCRIPTION
        while IFS= read -r name; do
            [[ -n "$name" ]] || continue
            installed="$(plugin_installed_version "$name" || true)"
            printf '%-14s %-24s %-7s %-16s %s\n' "$name" "$(catalog_field "$name" package)" \
                "$(catalog_field "$name" source)" "${installed:--}" "$(catalog_field "$name" description)"
        done < <(catalog_names)
    else
        warn "no plugin catalog in $BYRO_ROOT (plugin-catalog.conf); byroctl install or update fetches it"
    fi
    while IFS= read -r entry; do
        [[ -n "$entry" && -z "$(entry_name "$entry")" ]] || continue
        extras+=("$(entry_spec "$entry")")
    done < <(plugin_entries)
    if (( ${#extras[@]} > 0 )); then
        printf '\nAdditional entries in plugins/plugins.txt:\n'
        printf '  %s\n' "${extras[@]}"
    fi
    if plugins_configured; then
        printf '\nplugin image: %s\n' "$(plugins_image)"
    fi
}

plugin_add() {
    local skip=0 args=() arg snapshot was_active=0 prepared entry
    for arg in "$@"; do
        case "$arg" in
            --skip-safeguard) skip=1 ;;
            -*) die "unknown plugin add option: $arg; a plugin is a catalog name or a pip requirement, never a pip option (see byroctl plugin --help)" 64 ;;
            *) args+=("$arg") ;;
        esac
    done
    (( ${#args[@]} > 0 )) || die "usage: byroctl plugin add NAME|SPEC..." 64
    prepared="$(plugins_prepare_add "${args[@]}")" || exit $?
    if [[ -z "$prepared" ]]; then
        log "nothing to do"
        return 0
    fi
    snapshot="$(plugins_snapshot)"
    compose_file_active "$PLUGINS_COMPOSE" && was_active=1
    while IFS= read -r entry; do
        [[ -n "$entry" ]] || continue
        plugin_line "$(entry_spec "$entry")" "$(entry_name "$entry")" "$(entry_version "$entry")" >>"$PLUGINS_FILE"
        log "adding $(entry_label "$entry")"
    done <<<"$prepared"
    log "note: web is recreated once the image is built; users see a short interruption"
    plugins_finish "$snapshot" "$was_active" 0 "$skip"
}

plugin_remove() {
    local skip=0 args=() arg snapshot was_active=0 tmp line entry matched
    for arg in "$@"; do
        case "$arg" in
            --skip-safeguard) skip=1 ;;
            -*) die "unknown plugin remove option: $arg (see byroctl plugin --help)" 64 ;;
            *) args+=("$arg") ;;
        esac
    done
    (( ${#args[@]} > 0 )) || die "usage: byroctl plugin remove NAME|SPEC..." 64
    for arg in "${args[@]}"; do
        matched=0
        while IFS= read -r entry; do
            [[ -n "$entry" ]] || continue
            entry_matches "$entry" "$arg" && matched=1
        done < <(plugin_entries)
        (( matched )) || die "$arg is not listed in plugins/plugins.txt (byroctl plugin list)" 64
    done
    snapshot="$(plugins_snapshot)"
    compose_file_active "$PLUGINS_COMPOSE" && was_active=1
    tmp="$(mktemp "$PLUGINS_FILE.XXXXXX")"
    while IFS= read -r line || [[ -n "$line" ]]; do
        entry="$(plugin_parse_line "$line")"
        if [[ -n "$entry" ]]; then
            matched=0
            for arg in "${args[@]}"; do entry_matches "$entry" "$arg" && matched=1; done
            if (( matched )); then
                log "removing $(entry_spec "$entry")"
                continue
            fi
        fi
        printf '%s\n' "$line" >>"$tmp"
    done <"$PLUGINS_FILE"
    chmod 644 "$tmp"
    mv "$tmp" "$PLUGINS_FILE"
    plugins_finish "$snapshot" "$was_active" 0 "$skip"
    if ! plugins_configured; then
        log "back on the plain byro image. Database tables of removed plugins are kept (run 'byroctl manage migrate <app> zero' before removing a plugin if you want them gone); 'docker image rm $(plugins_image)' frees the old plugin image."
    fi
}

plugin_update() {
    local check=0 skip=0 names=() arg snapshot was_active=0 tmp rc=0
    for arg in "$@"; do
        case "$arg" in
            --check) check=1 ;;
            --skip-safeguard) skip=1 ;;
            -*) die "unknown plugin update option: $arg (see byroctl plugin --help)" 64 ;;
            *) valid_plugin_name "$arg" || die "not a catalog short name: $arg" 64; names+=("$arg") ;;
        esac
    done
    tmp="$(mktemp "$BYRO_ROOT/.byroctl/plugins.txt.XXXXXX")"
    plugins_resolve_updates "$tmp" "" "${names[@]}" || rc=$?
    case "$rc" in
        0) ;;
        3)
            rm -f "$tmp"
            log "all catalog plugins are at their current release"
            (( check )) && exit 3
            return 0 ;;
        *)
            rm -f "$tmp"
            die "plugin update stopped: a release tag moved (see above); nothing was changed, no plugin was updated" 1 ;;
    esac
    if (( check )); then
        rm -f "$tmp"
        log "run byroctl plugin update to apply"
        return 0
    fi
    snapshot="$(plugins_snapshot)"
    compose_file_active "$PLUGINS_COMPOSE" && was_active=1
    chmod 644 "$tmp"
    mv "$tmp" "$PLUGINS_FILE"
    log "note: web is recreated once the image is built; users see a short interruption"
    plugins_finish "$snapshot" "$was_active" 0 "$skip"
}

plugin_rebuild() {
    local nocache=() skip=0 arg snapshot was_active=0 applied
    for arg in "$@"; do
        case "$arg" in
            --no-cache) nocache=(--no-cache) ;;
            --skip-safeguard) skip=1 ;;
            *) die "unknown plugin rebuild option: $arg (see byroctl plugin --help)" 64 ;;
        esac
    done
    plugins_lint || die "plugins/plugins.txt has invalid entries (see above); fix them first" 1
    compose_file_active "$PLUGINS_COMPOSE" && was_active=1
    # The safeguard gets the list the running image was built from, not the
    # edited file: plugins/plugins.txt is the desired state, /byro/plugins.txt in
    # the image the previously applied one.
    applied="$(mktemp "$BYRO_ROOT/.byroctl/plugins.applied.XXXXXX")"
    if plugins_applied_state "$applied"; then
        snapshot="$(plugins_snapshot "$applied")"
    else
        log "no previously applied plugin state (no plugin container or image); the safeguard records that"
        snapshot="$(plugins_snapshot "")"
    fi
    rm -f "$applied"
    plugins_finish "$snapshot" "$was_active" 1 "$skip" "${nocache[@]}"
}

cmd_plugin() {
    local sub="${1:-}"
    [[ -n "$sub" ]] || { plugin_usage; exit 64; }
    shift
    case "$sub" in
        list) enter_root; plugin_list ;;
        add|remove|update|rebuild)
            enter_root; need_docker; need_buildx; acquire_lock; plugins_init
            "plugin_$sub" "$@" ;;
        -h|--help|help) plugin_usage; exit 0 ;;
        *) die "unknown plugin subcommand: $sub (list | add | remove | update | rebuild)" 64 ;;
    esac
}

# --- update ---------------------------------------------------------------------------------

release_notes_url() { printf 'https://github.com/byro/byro/releases/tag/%s' "$1"; }

# resolve_stable_version: the release tag named in stable.env, or empty. Only a
# line that exactly matches the expected form counts; the file is never sourced.
resolve_stable_version() {
    local content tmp url
    if [[ -n "${BYROCTL_STABLE_FILE:-}" ]]; then
        content="$(cat "$BYROCTL_STABLE_FILE")" || die "cannot read $BYROCTL_STABLE_FILE"
    else
        url="${BYROCTL_STABLE_URL:-$BYROCTL_RAW_BASE/stable/stable.env}"
        require_https "$url" "BYROCTL_STABLE_URL"
        tmp="$(mktemp)"
        if ! curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 -o "$tmp" "$url"; then
            rm -f "$tmp"
            die "cannot download $url"
        fi
        content="$(cat "$tmp")"
        rm -f "$tmp"
    fi
    grep -E '^BYRO_RELEASE_VERSION=v[0-9]+\.[0-9]+\.[0-9]+$' <<<"$content" | head -n1 | cut -d= -f2 || true
}

# read_release_flag FILE KEY: 0 or 1; anything else counts as 0.
read_release_flag() {
    local value
    value="$(grep -E "^$2=(0|1)$" "$1" 2>/dev/null | head -n1 | cut -d= -f2 || true)"
    printf '%s' "${value:-0}"
}

# version_relation CURRENT TARGET: same | newer | older | unordered
version_relation() {
    local current="$1" target="$2" first
    [[ "$current" == "$target" ]] && { printf 'same'; return 0; }
    if valid_version "$current" && valid_version "$target"; then
        first="$(printf '%s\n%s\n' "$current" "$target" | sort -V | head -n1)"
        if [[ "$first" == "$current" ]]; then printf 'newer'; else printf 'older'; fi
    else
        printf 'unordered'
    fi
}

# fetch_sums TAG: prints the path of a temporary SHA256SUMS for TAG, or nothing
# when the local development source is used.
fetch_sums() {
    local tag="$1" sums
    [[ -z "$BYROCTL_SOURCE_DIR" ]] || return 0
    sums="$(mktemp "$BYRO_ROOT/.byroctl/SHA256SUMS.XXXXXX")"
    fetch_artifact "$tag" SHA256SUMS "$sums"
    printf '%s' "$sums"
}

# fetch_verified TAG RELPATH DEST SUMS: fetch and verify (SUMS empty -> unverified local source)
fetch_verified() {
    local tag="$1" relpath="$2" dest="$3" sums="$4"
    fetch_artifact "$tag" "$relpath" "$dest"
    if [[ -n "$sums" ]]; then
        verify_checksum "$sums" "$relpath" "$dest"
    fi
}

# run_hook NAME FROM TO: runs .byroctl/hooks/NAME.sh if executable.
run_hook() {
    local hook="$BYRO_ROOT/.byroctl/hooks/$1.sh"
    [[ -x "$hook" ]] || return 0
    log "running hook $1"
    BYRO_ROOT="$BYRO_ROOT" BYROCTL_FROM="$2" BYROCTL_TO="$3" "$hook" || die "hook $1 failed (exit $?)"
}

# migrate_conf EXAMPLE: append keys of the new example that byro.conf does not
# know (active or commented), together with their comment block. Reports keys in
# byro.conf that the example does not know. Never removes or reorders anything.
migrate_conf() {
    local example="$1" line key block=() added=() unknown=() known=()
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" =~ ^#?([A-Z][A-Z0-9_]*)= ]]; then
            key="${BASH_REMATCH[1]}"
            known+=("$key")
            if ! grep -qE "^#?$key=" "$CONF_FILE"; then
                {
                    printf '\n'
                    printf '%s\n' "${block[@]}"
                    printf '%s\n' "$line"
                } >>"$CONF_FILE"
                added+=("$key")
            fi
            block=()
        elif [[ "$line" == "#"* ]]; then
            block+=("$line")
        else
            block=()
        fi
    done <"$example"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ "$line" =~ ^([A-Z][A-Z0-9_]*)= ]] || continue
        key="${BASH_REMATCH[1]}"
        [[ " ${known[*]} " == *" $key "* ]] || unknown+=("$key")
    done <"$CONF_FILE"
    (( ${#added[@]} == 0 )) || log "added new configuration keys with defaults: ${added[*]}"
    (( ${#unknown[@]} == 0 )) || warn "byro.conf contains keys the new release does not know: ${unknown[*]} (kept, please review)"
    chmod 600 "$CONF_FILE"
}

# update_artifacts TAG SUMS: replace the compose files with those of TAG, showing a diff.
update_artifacts() {
    local tag="$1" sums="$2" relpath tmp
    for relpath in "${BYROCTL_ARTIFACTS[@]}"; do
        mkdir -p "$BYRO_ROOT/$(dirname "$relpath")"
        tmp="$(mktemp "$BYRO_ROOT/$relpath.XXXXXX")"
        fetch_verified "$tag" "$relpath" "$tmp" "$sums"
        chmod 644 "$tmp"
        if [[ -f "$BYRO_ROOT/$relpath" ]] && ! cmp -s "$BYRO_ROOT/$relpath" "$tmp"; then
            log "changes in $relpath:"
            diff -u "$BYRO_ROOT/$relpath" "$tmp" >&2 || true
        fi
        mv "$tmp" "$BYRO_ROOT/$relpath"
    done
}

# pre_update_safeguard CURRENT DIGEST TARGET [PREFIX] [SNAPSHOT]: dump + byro.conf
# + plugins.txt + .secret + META in backups/PREFIX-CURRENT-<timestamp>/. With a
# SNAPSHOT directory (plugin commands), byro.conf and plugins.txt are taken from
# there, i.e. the state before the command started changing files; a snapshot
# without plugins.txt means no previously applied plugin state existed.
pre_update_safeguard() {
    local current="$1" digest="$2" target="$3" prefix="${4:-pre-update}" snapshot="${5:-}"
    local dir major db_user db_name db_host db_port conf_src plugins_src="" plugins_note=""
    dir="$BYRO_ROOT/backups/$prefix-$current-$(date -u +%Y%m%d-%H%M%S)"
    mkdir -p "$dir"
    chmod 700 "$dir"
    db_user="$(conf_get BYRO_DB_USER 2>/dev/null || true)"; db_user="${db_user:-byro}"
    db_name="$(conf_get BYRO_DB_NAME 2>/dev/null || true)"; db_name="${db_name:-byro}"
    conf_src="$CONF_FILE"
    if [[ -n "$snapshot" ]]; then
        conf_src="$snapshot/byro.conf"
        if [[ -f "$snapshot/plugins.txt" ]]; then
            plugins_src="$snapshot/plugins.txt"
        else
            plugins_note="none (no plugin container or image existed before this command)"
        fi
    elif [[ -f "$PLUGINS_FILE" ]]; then
        plugins_src="$PLUGINS_FILE"
    else
        plugins_note="none (no plugins/plugins.txt)"
    fi
    log "$prefix safeguard: dumping the database to $dir/db.dump"
    if compose_file_active compose/postgres.yml; then
        compose up -d db
        wait_healthy db "$BYROCTL_DB_HEALTH_TIMEOUT" || die "the database is not healthy; cannot create the pre-update dump"
        compose exec -T db pg_dump -Fc -U "$db_user" "$db_name" >"$dir/db.dump"
    else
        db_host="$(conf_get BYRO_DB_HOST)" || die "BYRO_DB_HOST is not set"
        db_port="$(conf_get BYRO_DB_PORT 2>/dev/null || true)"; db_port="${db_port:-5432}"
        major="$(conf_get BYRO_DEPLOY_POSTGRES_MAJOR 2>/dev/null || true)"; major="${major:-17}"
        PGPASSWORD="$(conf_get BYRO_DB_PASS 2>/dev/null || true)" \
            docker run --rm -e PGPASSWORD "postgres:$major-alpine" \
            pg_dump -h "$db_host" -p "$db_port" -U "$db_user" -Fc "$db_name" >"$dir/db.dump"
    fi
    [[ -s "$dir/db.dump" ]] || die "the database dump is empty; not continuing without a safeguard (use --skip-safeguard to override)"
    cp "$conf_src" "$dir/byro.conf"
    chmod 600 "$dir/byro.conf"
    if [[ -n "$plugins_src" ]]; then
        cp "$plugins_src" "$dir/plugins.txt"
        chmod 644 "$dir/plugins.txt"
    fi
    if [[ -f "$BYRO_ROOT/data/.secret" ]]; then
        cp "$BYRO_ROOT/data/.secret" "$dir/.secret"
        chmod 600 "$dir/.secret"
    else
        warn "data/.secret not found; nothing to copy"
    fi
    {
        printf 'BYROCTL_KIND=%s\n' "$prefix"
        printf 'BYROCTL_PREVIOUS_VERSION=%s\n' "$current"
        printf 'BYROCTL_PREVIOUS_DIGEST=%s\n' "$digest"
        printf 'BYROCTL_TARGET_VERSION=%s\n' "$target"
        printf 'BYROCTL_PREVIOUS_PLUGINS=%s\n' "$([[ -n "$plugins_src" ]] && printf 'plugins.txt' || printf '%s' "'$plugins_note'")"
        printf 'BYROCTL_CREATED_AT=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf 'BYROCTL_NOTE=%s\n' "'$prefix safeguard, not a full backup: documents and other files in data/ are not included'"
    } >"$dir/META"
    printf '%s' "$dir"
}

rollback_hint() {
    local current="$1" digest="$2" safeguard="$3"
    log "byro was NOT updated successfully. The stack is stopped (the database keeps running)."
    log "Manual way back to byro $current:"
    log "  1. byroctl config set BYRO_DEPLOY_VERSION $current"
    if [[ -n "$digest" ]]; then
        log "  2. byroctl config set BYRO_DEPLOY_IMAGE_DIGEST $digest"
    else
        log "  2. byroctl config set BYRO_DEPLOY_IMAGE_DIGEST ''"
    fi
    log "  3. fetch the compose files of $current again (deploy/ of that tag) or restore them from ${safeguard:-your backup}"
    if plugins_configured; then
        log "  3b. byroctl plugin rebuild (rebuilds the plugin image for $current; plugins.txt of that version is in ${safeguard:-the safeguard})"
    fi
    if [[ -n "$safeguard" ]]; then
        log "  4. if the migration changed the database: restore $safeguard/db.dump with pg_restore, then"
    fi
    log "  5. byroctl start"
}

update_usage() {
    cat >&2 <<'USAGE'
Usage: byroctl update [options]

  --check                 only report whether an update is available (exit 0) or not (exit 3)
  --to TAG                update to this release instead of the current stable one
  --prefetch              only download the target image, change nothing
  --yes                   confirm the update (and a release flagged as breaking) without asking
  --skip-safeguard        do not create the pre-update safeguard (database dump, byro.conf, .secret)
  --data-safeguard-done   confirm that a full backup of data/ exists (required when the
                          release changes persistent files)
  --update-plugins        also move catalog plugins to their current release; without
                          this the plugin pins stay as they are (the image is rebuilt anyway)
  --non-interactive       never prompt
  --no-pull               use the locally present target image (development)
USAGE
}

cmd_update() {
    local check=0 prefetch=0 skip_safeguard=0 data_ok=0 yes=0 no_pull=0 stage2=0 update_plugins=0 target=""
    local current repo digest relation sums="" relenv breaking datamig notes next flags=() safeguard="" now new_digest
    local plugins_next="" catalog_next prc
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) check=1; shift ;;
            --to) [[ $# -ge 2 ]] || die "--to needs a tag" 64; target="$2"; shift 2 ;;
            --to=*) target="${1#--to=}"; shift ;;
            --prefetch) prefetch=1; shift ;;
            --skip-safeguard) skip_safeguard=1; shift ;;
            --data-safeguard-done) data_ok=1; shift ;;
            --update-plugins) update_plugins=1; shift ;;
            --yes) yes=1; shift ;;
            --no-pull) no_pull=1; shift ;;
            --non-interactive) NONINTERACTIVE=1; shift ;;
            --stage2) stage2=1; shift ;;
            -h|--help) update_usage; exit 0 ;;
            *) die "unknown update option: $1 (see byroctl update --help)" 64 ;;
        esac
    done
    enter_root
    need_docker
    acquire_lock
    if [[ -z "$BYROCTL_SOURCE_DIR" ]]; then
        require_https "$BYROCTL_RAW_BASE" "BYROCTL_RAW_BASE"
    fi

    current="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
    [[ -n "$current" ]] || die "byro.conf has no BYRO_DEPLOY_VERSION"
    repo="$(conf_get BYRO_DEPLOY_IMAGE_REPO 2>/dev/null || true)"
    repo="${repo:-$BYROCTL_DEFAULT_REPO}"
    digest="$(conf_get BYRO_DEPLOY_IMAGE_DIGEST 2>/dev/null || true)"

    # --- target version
    if [[ -z "$target" ]]; then
        target="$(resolve_stable_version)"
        [[ -n "$target" ]] || die "stable.env does not name a valid release (expected BYRO_RELEASE_VERSION=vYYYY.M.P); use --to TAG to choose one explicitly"
    fi
    if [[ -z "$BYROCTL_SOURCE_DIR" ]]; then
        valid_version "$target" || die "invalid byro release tag: $target (expected vYYYY.M.P)"
    else
        valid_tag "$target" || die "invalid image tag: $target"
    fi
    relation="$(version_relation "$current" "$target")"
    case "$relation" in
        same)
            log "byro $current is the current release, nothing to do"
            (( check )) && exit 3
            return 0 ;;
        older)
            die "byro $target is older than the installed $current. A downgrade is not an update: Django migrations do not run backwards. Restore a pre-update safeguard instead (see byroctl update --help)." ;;
        unordered)
            warn "cannot order $current and $target (not release tags); continuing" ;;
    esac

    # --- gate and release metadata
    if (( no_pull )); then
        image_local "$repo:$target" || die "--no-pull: image $repo:$target is not present locally"
    else
        image_exists "$repo:$target" || die "image $repo:$target does not exist in the registry (not a published release, or no registry access)"
    fi
    sums="$(fetch_sums "$target")"
    relenv="$(mktemp "$BYRO_ROOT/.byroctl/release.env.XXXXXX")"
    fetch_verified "$target" release.env "$relenv" "$sums"
    breaking="$(read_release_flag "$relenv" BYRO_RELEASE_BREAKING)"
    datamig="$(read_release_flag "$relenv" BYRO_RELEASE_DATA_MIGRATION)"
    rm -f "$relenv"
    notes="$(release_notes_url "$target")"

    if (( check )); then
        printf 'installed:      %s\n' "$current"
        printf 'available:      %s\n' "$target"
        printf 'release notes:  %s\n' "$notes"
        printf 'breaking:       %s\n' "$([[ "$breaking" == 1 ]] && printf 'yes - read the release notes and confirm with --yes' || printf 'no')"
        printf 'file migration: %s\n' "$([[ "$datamig" == 1 ]] && printf 'yes - a full backup of data/ is required (--data-safeguard-done)' || printf 'no')"
        if plugins_configured; then
            printf 'plugins:        %s configured; the plugin image is rebuilt for %s with the pins unchanged (--update-plugins moves catalog plugins to their current release)\n' \
                "$(plugin_specs | grep -c . || true)" "$target"
        fi
        [[ -z "$sums" ]] || rm -f "$sums"
        return 0
    fi
    if (( prefetch )); then
        [[ -z "$sums" ]] || rm -f "$sums"
        if (( no_pull )); then
            log "--prefetch with --no-pull: nothing to download"
        else
            log "prefetching $repo:$target ..."
            docker pull "$repo:$target"
        fi
        return 0
    fi

    # --- decisions before anything changes
    if [[ "$datamig" == 1 && $data_ok -eq 0 ]]; then
        [[ -z "$sums" ]] || rm -f "$sums"
        log "byro $target changes persistent files in data/ (documents, uploads, keys)."
        log "The regular pre-update safeguard (database dump, byro.conf, .secret) is NOT sufficient for this release."
        log "Create a full backup of $BYRO_ROOT/data first, read $notes,"
        log "then run: byroctl update --to $target --data-safeguard-done"
        exit 1
    fi
    if [[ "$breaking" == 1 && $yes -eq 0 ]]; then
        log "byro $target is flagged as breaking: read $notes before updating."
        if (( NONINTERACTIVE )) || ! confirm "Continue with the update to $target?" n; then
            [[ -z "$sums" ]] || rm -f "$sums"
            die "update not confirmed (use --yes after reading the release notes)"
        fi
        yes=1
    fi
    if (( yes == 0 && stage2 == 0 )); then
        if (( NONINTERACTIVE )); then
            [[ -z "$sums" ]] || rm -f "$sums"
            die "use --yes to run a non-interactive update from $current to $target"
        fi
        if ! confirm "Update byro $current -> $target now?" y; then
            [[ -z "$sums" ]] || rm -f "$sums"
            die "update aborted"
        fi
        yes=1
    fi

    # --- stage 2: continue with the byroctl of the target release
    if (( stage2 == 0 )); then
        next="$BYRO_ROOT/.byroctl/byroctl.next"
        fetch_verified "$target" byroctl "$next" "$sums"
        bash -n "$next" || die "byroctl of $target does not parse; not switching"
        chmod 755 "$next"
        [[ -z "$sums" ]] || rm -f "$sums"
        flags=(--yes)
        (( skip_safeguard )) && flags+=(--skip-safeguard)
        (( data_ok )) && flags+=(--data-safeguard-done)
        (( update_plugins )) && flags+=(--update-plugins)
        (( no_pull )) && flags+=(--no-pull)
        (( NONINTERACTIVE )) && flags+=(--non-interactive)
        log "switching to byroctl of $target and continuing the update"
        exec bash "$next" --root "$BYRO_ROOT" update --stage2 --to "$target" "${flags[@]}"
    fi

    # ------------------------------------------------------------------ stage 2
    log "updating byro $current -> $target"
    local free_kb
    free_kb="$(df -Pk "$BYRO_ROOT" 2>/dev/null | awk 'NR == 2 {print $4}')"
    if [[ -n "$free_kb" ]] && (( free_kb < 2 * 1024 * 1024 )); then
        die "less than 2 GB free in $BYRO_ROOT; free some space before updating"
    fi
    compose config -q || die "the current compose configuration is invalid; fix it (byroctl config check) before updating"

    # plugins: lint, and with --update-plugins resolve every catalog entry against
    # the target's catalog now, before anything is changed. A moved release tag
    # stops the update here (fail-closed); the new list is applied after the pull.
    if plugins_configured; then
        plugins_lint || die "plugins/plugins.txt has invalid entries (see above); fix them before updating"
        if (( update_plugins )); then
            catalog_next="$(mktemp "$BYRO_ROOT/.byroctl/plugin-catalog.XXXXXX")"
            fetch_verified "$target" plugin-catalog.conf "$catalog_next" "$sums"
            plugins_next="$(mktemp "$BYRO_ROOT/.byroctl/plugins.txt.XXXXXX")"
            prc=0
            plugins_resolve_updates "$plugins_next" "$catalog_next" || prc=$?
            rm -f "$catalog_next"
            case "$prc" in
                0) log "catalog plugins will be moved to their current release during the update" ;;
                3) rm -f "$plugins_next"; plugins_next=""; log "catalog plugins are already at their current release" ;;
                *) rm -f "$plugins_next"; [[ -z "$sums" ]] || rm -f "$sums"
                   die "a plugin release tag moved (see above); the update was not started and nothing was changed" ;;
            esac
        fi
    fi
    run_hook pre-update "$current" "$target"

    if (( skip_safeguard )); then
        warn "skipping the pre-update safeguard (--skip-safeguard)"
    else
        safeguard="$(pre_update_safeguard "$current" "$digest" "$target")"
        log "safeguard written to $safeguard"
    fi

    # configuration and compose files of the target release
    local example
    example="$(mktemp "$BYRO_ROOT/.byroctl/byro.conf.example.XXXXXX")"
    fetch_verified "$target" byro.conf.example "$example" "$sums"
    migrate_conf "$example"
    rm -f "$example"
    conf_set BYRO_DEPLOY_VERSION "$target"
    conf_set BYRO_DEPLOY_IMAGE_DIGEST ""
    update_artifacts "$target" "$sums"
    [[ -z "$sums" ]] || rm -f "$sums"
    compose config -q || { rollback_hint "$current" "$digest" "$safeguard"; die "the compose files of $target do not validate with your byro.conf (see above)"; }

    # images
    if (( no_pull )); then
        image_local "$repo:$target" || die "--no-pull: image $repo:$target disappeared"
        log "using the local image $repo:$target (--no-pull); the digest stays unpinned"
    else
        log "pulling images for byro $target ..."
        pull_images "$repo:$target"
        new_digest="$(image_digest "$repo" "$repo:$target")"
        [[ -n "$new_digest" ]] || { rollback_hint "$current" "$digest" "$safeguard"; die "the pulled image $repo:$target carries no digest for $repo"; }
        valid_digest "$new_digest" || die "unexpected digest format: $new_digest"
        conf_set BYRO_DEPLOY_IMAGE_DIGEST "$new_digest"
        log "pinned image digest $new_digest"
    fi

    # plugin image on top of the new base (the running stack is untouched until
    # the build succeeded)
    if plugins_configured; then
        if [[ -n "$plugins_next" ]]; then
            log "moving catalog plugins to their current release:"
            diff -u "$PLUGINS_FILE" "$plugins_next" >&2 || true
            mv "$plugins_next" "$PLUGINS_FILE"
            plugins_next=""
        fi
        compose_file_add "$PLUGINS_COMPOSE"
        need_buildx
        log "building the byro image with plugins for $target ($(plugins_image)) ..."
        if ! compose build web; then
            rollback_hint "$current" "$digest" "$safeguard"
            die "building the image with plugins for $target failed (see above); the running stack was not touched"
        fi
    fi

    # switch over
    log "stopping byro services (the database keeps running) ..."
    compose stop periodic web
    log "applying database migrations ..."
    if ! compose run --rm -T manage migrate --noinput; then
        rollback_hint "$current" "$digest" "$safeguard"
        die "database migration to $target failed"
    fi
    log "starting byro $target ..."
    compose up -d --remove-orphans
    if ! wait_healthy web "$BYROCTL_WEB_HEALTH_TIMEOUT"; then
        rollback_hint "$current" "$digest" "$safeguard"
        die "byro $target did not become healthy; check 'byroctl logs web'"
    fi
    run_hook post-update "$current" "$target"

    now="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_state BYROCTL_PREVIOUS_VERSION "$current"
    write_state BYROCTL_PREVIOUS_DIGEST "$digest"
    write_state BYROCTL_LAST_UPDATE "$now"
    if [[ -f "$BYRO_ROOT/.byroctl/byroctl.next" ]]; then
        mv "$BYRO_ROOT/.byroctl/byroctl.next" "$BYRO_ROOT/byroctl"
        chmod 755 "$BYRO_ROOT/byroctl"
    fi
    cat <<SUMMARY

byro updated: $current -> $target

  release notes:  $notes
  safeguard:      ${safeguard:-skipped}
  previous image: ${digest:-unpinned}
  plugins:        $(plugin_summary)$(plugins_configured && printf '  (image %s; the previous plugin image can go with: docker image rm %s)' "$(plugins_image)" "$(conf_get COMPOSE_PROJECT_NAME 2>/dev/null || printf byro)-plugins:$current")

Old images are kept (docker image prune removes them when you no longer need a way back).
SUMMARY
}

cmd_self_update() {
    local version sums tmp
    [[ $# -eq 0 ]] || die "self-update takes no arguments" 64
    enter_root
    acquire_lock
    version="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
    [[ -n "$version" ]] || die "byro.conf has no BYRO_DEPLOY_VERSION"
    if [[ -z "$BYROCTL_SOURCE_DIR" ]]; then
        require_https "$BYROCTL_RAW_BASE" "BYROCTL_RAW_BASE"
        valid_version "$version" || die "invalid byro release tag in byro.conf: $version"
    fi
    sums="$(fetch_sums "$version")"
    tmp="$(mktemp "$BYRO_ROOT/.byroctl/byroctl.self.XXXXXX")"
    fetch_verified "$version" byroctl "$tmp" "$sums"
    [[ -z "$sums" ]] || rm -f "$sums"
    bash -n "$tmp" || die "byroctl of $version does not parse; keeping the current script"
    if cmp -s "$tmp" "$BYRO_ROOT/byroctl"; then
        rm -f "$tmp"
        log "byroctl is already the version shipped with byro $version"
        return 0
    fi
    chmod 755 "$tmp"
    mv "$tmp" "$BYRO_ROOT/byroctl"
    log "byroctl replaced with the version shipped with byro $version"
}

# --- commands (filled in below) -----------------------------------------------------------

usage() {
    cat >&2 <<'USAGE'
Usage: byroctl [--root DIR] <command> [options]

Commands:
  install      set up a new byro installation in the root directory
  config       get KEY | set KEY VALUE [--apply] | edit | check
  start        start the stack and wait for byro to become healthy
  stop         stop the stack (data and containers are kept)
  restart      recreate the byro services (web, periodic, caddy), not the database
  logs         show logs: byroctl logs [-f] [SERVICE...]
  manage       run a byro management command: byroctl manage migrate
  plugin       list | add NAME|SPEC... | remove NAME... | update [--check] | rebuild
  update       update to the current stable release: byroctl update [--check] [--to TAG]
  self-update  re-fetch byroctl for the installed release (repair)
  version      show the installed and running byro version and plugins
  help         this text

Global options:
  --root DIR   installation directory (default: directory of this script,
               or BYRO_ROOT from the environment)
USAGE
}

cmd_version() {
    local version digest running loaded
    version="$(conf_get BYRO_DEPLOY_VERSION 2>/dev/null || true)"
    digest="$(conf_get BYRO_DEPLOY_IMAGE_DIGEST 2>/dev/null || true)"
    printf 'byro version:   %s\n' "${version:-unset}"
    printf 'image digest:   %s\n' "${digest:-not pinned}"
    printf 'root:           %s\n' "$BYRO_ROOT"
    printf 'compose files:  %s\n' "$(compose_files | tr '\n' ' ')"
    printf 'plugins:        %s\n' "$(plugin_summary)"
    if [[ -n "$(container_id web)" ]]; then
        running="$(compose exec -T web python -c 'import byro; print(byro.__version__)' 2>/dev/null | tail -n1 || true)"
        printf 'running byro:   %s\n' "${running:-unknown}"
        loaded="$(compose exec -T web python -c 'from django.conf import settings; print(" ".join(settings.PLUGINS))' 2>/dev/null | tail -n1 || true)"
        printf 'loaded plugins: %s\n' "${loaded:-none}"
    else
        printf 'running byro:   not running\n'
    fi
}

main() {
    set -euo pipefail
    local root="${BYRO_ROOT:-}" cmd=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root) [[ $# -ge 2 ]] || die "--root needs a directory" 64; root="$2"; shift 2 ;;
            --root=*) root="${1#--root=}"; shift ;;
            -h|--help|help) usage; exit 0 ;;
            -*) die "unknown global option: $1" 64 ;;
            *) cmd="$1"; shift; break ;;
        esac
    done
    [[ -n "$cmd" ]] || { usage; exit 64; }
    if [[ -z "$root" ]]; then
        root="$(script_dir)"
    fi
    BYRO_ROOT="${root%/}"
    CONF_FILE="$BYRO_ROOT/byro.conf"
    PLUGINS_FILE="$BYRO_ROOT/plugins/plugins.txt"
    case "$cmd" in
        install) cmd_install "$@" ;;
        config)  cmd_config "$@" ;;
        start)   cmd_start "$@" ;;
        stop)    cmd_stop "$@" ;;
        restart) cmd_restart "$@" ;;
        logs)    cmd_logs "$@" ;;
        manage)  cmd_manage "$@" ;;
        plugin)  cmd_plugin "$@" ;;
        update)  cmd_update "$@" ;;
        self-update) cmd_self_update "$@" ;;
        version) enter_root; cmd_version ;;
        *) die "unknown command: $cmd (try byroctl help)" 64 ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
